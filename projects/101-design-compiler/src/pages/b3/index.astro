---
import Foundation from '../../layouts/Foundation.astro';
import {loadB3DepthExperience as loadB3RichExperience} from '../../../scripts/load-b3-depth-experience.ts';
import {styleEngines,newEngineProfiles} from '../../design/style-engines.ts';
const lab=await loadB3RichExperience(),roles={general:'Uso general',artistic:'Artístico'},statuses={PRELIMINARY_ACCEPTED:'Dirección de entrada conservada · revisión pendiente',AWAITING_HUMAN_REVIEW:'Pendiente de tu valoración'},rationale:Record<string,string>={...Object.fromEntries([...lab.site.profiles,...newEngineProfiles(lab)].map(p=>[p.id,p.rationale])),'candidate-03':'Escena audiovisual oscura a toda pantalla con composición de revista: carril de ascuas, tipografía Syne y película manual. Motor artístico preliminar.','candidate-04':'Láminas botánicas sobre papel: Fraunces, vino y composición de herbario con una película de fondo discreta. Motor artístico preliminar.','candidate-05':'Casa y patio: comedor mediterráneo cálido, foto a toda pantalla, terracota y azafrán. Uso general.','candidate-06':'Cocina abierta: comedor nocturno verde profundo y latón, tipografía Archivo con Newsreader. Uso general.','candidate-07':'Cartel duotono: fotografías en índigo y coral sobre papel de periódico. Motor artístico.','candidate-08':'Hoja de contactos: fotogramas en gris que se revelan a color. Motor artístico.'};
---
<Foundation title="B3 · Ocho motores de estilo">
 <p>101 / Revisión de diseño · B3 · Motores de estilo del laboratorio de restaurante</p><h1>Ocho motores.<br/>Un mismo restaurante.</h1><p class="intro">01–04 conservan su identidad inicial con navegación, menú, reservas y ubicación renovados (y una tipografía nueva en 04). 05–08 son cuatro propuestas nuevas, dos de uso general y dos artísticas, que esperan tu valoración. Todas muestran los mismos datos ficticios, la misma carta de cuarenta platos y las mismas funciones de demostración.</p>
 <div class="candidates">{styleEngines.map(e=><article><p>{roles[e.role]} · {statuses[e.status]} · once páginas</p><h2><a href={e.root}>{e.id.slice(-2)} · {e.label} ↗</a></h2><p>{rationale[e.id]}</p><a class="open" href={e.root}>Abrir el sitio ↗</a><div class="page-shortcuts"><a href={`${e.root}carta/`}>Menú</a><a href={`${e.root}reservas/`}>Reservas</a><a href={`${e.root}visita/`}>Ubicación</a></div></article>)}</div>
 <section><h2>Tu criterio decide.</h2><p>Puedes elegir una, varias o <strong>ninguna</strong>. Mira cada una en escritorio y móvil. Coméntame qué te gusta y qué cambiarías de la tipografía, paleta, distribución, audiovisual, contenido y móvil. No hay una ganadora preseleccionada.</p><p>Son motores de laboratorio para restaurantes, todavía no motores de producción universales. Estas páginas no son un Design Lock aprobado.</p></section>
 <details><summary>Qué puedes probar y qué sigue pendiente</summary><p>Menú con búsqueda, categorías y recetas ficticias; reservas con interfaz demostrativa; ubicación con un punto de ejemplo y mapa que sólo se carga al pulsar. Noticias con categorías y lectura ampliada. Navegación agrupada con cierre Escape. No hay backend, pagos, reseñas reales, disponibilidad real o datos personales.</p><p>Las imágenes y vídeos son de stock con licencia, ilustrativos y sin audio; los vídeos de plato se reproducen sólo con sus controles. Los créditos y condiciones están en una página accesible desde cada pie. Nada representa una empresa o platos reales.</p><p>Toda esta revisión está pendiente de tu valoración. De 01–04 sólo se conserva la dirección de entrada que te gustó; navegación, menú, reservas, ubicación y la tipografía de 04 son nuevos. No hay aprobación final de ningún motor.</p></details>
 <p><a href="/b2/demo/">Paquete audiovisual B2</a> · <a href="/b1/revision/">Catálogo de funcionalidades</a></p>
</Foundation>
<style>h1{font-family:Georgia,serif;font-weight:400;letter-spacing:-.06em;font-size:clamp(3rem,7vw,6rem)}.intro{font-size:1.25rem;max-width:60ch}.candidates{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,20rem),1fr));gap:1.5rem;margin-block:3rem}.candidates article{padding:2rem;background:#fff;border:1px solid #aaa}article p{font-size:1rem}article h2{font-size:2rem;font-family:Georgia,serif;font-weight:400;margin:.75rem 0}article h2 a{color:#181818;text-decoration:none}.open,.page-shortcuts a{display:inline-flex;align-items:center;min-height:48px;color:#181818}.open{margin-top:1rem}.page-shortcuts{display:flex;gap:1rem;flex-wrap:wrap}summary{padding:1rem 0;min-height:44px;cursor:pointer}@media(max-width:720px){.candidates{grid-template-columns:1fr}.candidates article{padding:1.5rem}}</style>
