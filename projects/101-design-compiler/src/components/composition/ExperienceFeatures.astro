---
import type {ExperienceFeatures} from '../../design/depth-experience-contracts.ts';
import {richExperiencePages} from '../../design/rich-experience-contracts.ts';
import {experienceRoute} from '../../design/experience-contracts.ts';
interface Props{features:ExperienceFeatures;root:string;mode:'home'|'visit'|'request'}
const {features:f,root,mode}=Astro.props;
---
{mode==='home'?<section class="experience-overview" data-feature="route-directory" data-reveal aria-labelledby="overview-title"><div class="house-note"><p class="eyebrow">{f.house.eyebrow}</p><h2 id="overview-title">{f.house.title}</h2><p>{f.house.copy}</p><a class="text-link" href={`${root}historia/`}>Nuestra idea <span aria-hidden="true">↗</span></a></div><div class="route-directory">{f.directory.map((d,i)=><a data-directory-kind={d.page_kind} href={experienceRoute(root,richExperiencePages.find(p=>p.kind===d.page_kind)! as any)}><span class="directory-number" aria-hidden="true">0{i+1}</span><div><h3>{d.title}</h3><p>{d.copy}</p></div><span class="directory-arrow" aria-hidden="true">↗</span></a>)}</div></section>:<aside class="visit-preparation" data-feature={mode==='visit'?'visit-preparation':'groups-preview'}><p class="eyebrow">{mode==='visit'?'Antes de salir':'Una ocasión para reunirse'}</p><h2>{mode==='visit'?'El plan, sin dudas.':'¿Una mesa más larga?'}</h2><p>{mode==='visit'?f.visit_prompt:f.events_prompt}</p><a class="text-link" href={`${root}${mode==='visit'?'preguntas':'contacto'}/`}>{mode==='visit'?'Preguntas antes de venir':'Explorar contacto de muestra'}<span aria-hidden="true">↗</span></a></aside>}
