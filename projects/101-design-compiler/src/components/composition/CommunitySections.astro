---
import ContextualImage from './ContextualImage.astro';
import type {ExperienceFeatures} from '../../design/depth-experience-contracts.ts';
import type {loadB3RichExperience} from '../../../scripts/load-b3-rich-experience.ts';
interface Props{lab:Pick<Awaited<ReturnType<typeof loadB3RichExperience>>,'community'|'experience_media'>;root:string;route:string;mode:'home'|'journal'|'reviews'|'contact';features?:ExperienceFeatures;noSupplemental?:boolean;only?:Array<'journal'|'reviews'|'contact'>}
const {lab,root,route,mode,features,noSupplemental=false,only}=Astro.props,c=lab.community,home=mode==='home';
const show=(k:'journal'|'reviews'|'contact')=>only?only.includes(k):home||mode===k;---
{show('journal')&&<section class="community-journal" data-editorial-section="journal" aria-labelledby="journal-title">
 <header class="community-heading"><div><h2 id="journal-title">Noticias</h2></div><div><p>Novedades y relatos de muestra del restaurante ficticio.</p>{home&&<a class="text-link" href={`${root}diario/`}>Ver todas las noticias <span aria-hidden="true">↗</span></a>}</div></header>
 {features&&mode==='journal'&&<div class="journal-tools" data-journal-tools hidden><label>Filtrar por tema<select data-journal-category><option value="">Todos los relatos</option>{features.reads.map(r=><option value={r.category}>{r.category}</option>)}</select></label><p role="status" data-journal-count>4 relatos de muestra</p></div>}
 <div class="journal-grid" data-journal-layout="all">{c.posts.slice(0,home?3:4).map((post,i)=>{const read=features?.reads.find(r=>r.post_id===post.id);return <article class="journal-entry" data-editorial-id={post.id} data-journal-category={read?.category} data-reveal><div class="journal-number" aria-hidden="true">0{i+1}</div><ContextualImage handle={lab.experience_media.handle} at={lab.experience_media.evaluated_at} {route} slot={`journal-${post.slot}`} creditMode="linked" creditsHref={`${root}creditos/`} cover/><div class="journal-copy"><p class="eyebrow">{read?.category??['Compartir','Disfrutar','Descubrir','Quedarse'][i]}</p><h3>{post.title}</h3><p>{post.caption}</p>{read&&<details class="journal-reading" data-read-id={read.post_id}><summary>Leer el relato <span aria-hidden="true">＋</span></summary><div><p class="editorial-disclosure">{read.label}</p>{read.body.map(t=><p data-read-paragraph>{t}</p>)}</div></details>}</div></article>;})}</div>
 <p class="editorial-disclosure" data-social-disclosure>Selección editorial de muestra con imágenes ilustrativas. No son publicaciones de Instagram ni contenido de una cuenta real.</p>
</section>}
{show('reviews')&&<section class="community-reviews" data-editorial-section="reviews" aria-labelledby="reviews-title"><header class="community-heading"><div><h2 id="reviews-title">Opiniones</h2></div><div><p class="editorial-disclosure" data-review-disclosure>Opiniones de muestra · personajes y textos ficticios. No son reseñas de clientes.</p>{home&&<a class="text-link" href={`${root}opiniones/`}>Leer todas las opiniones <span aria-hidden="true">↗</span></a>}</div></header><div class="review-grid">{c.reviews.slice(0,home?2:3).map((r,i)=><figure class="review-card" data-demo-review={r.id}><span class="quote-mark" aria-hidden="true">“</span><blockquote>{r.quote}</blockquote><figcaption class="review-byline"><span aria-hidden="true">0{i+1}</span><div><p>{r.author}</p><p class="review-label">{r.label}</p></div></figcaption></figure>)}</div></section>}
{show('contact')&&<section class="community-contact" data-editorial-section="contact" aria-labelledby="contact-title"><div><h2 id="contact-title">Contacto</h2><p>Una pregunta, una celebración o ganas de venir: elige cómo.</p><div class="demo-contact-details" data-demo-contact><p class="eyebrow">Correo de ejemplo</p><p class="contact-address">{c.contact.email}</p><p>Dirección ficticia, sin recepción de mensajes.</p><button type="button" disabled aria-describedby="contact-demo-notice">Consultar por WhatsApp ↗</button><p id="contact-demo-notice">Vista de demostración: no hay número ni canal de envío conectado.</p></div><nav class="contact-shortcuts" aria-label="Otras vías"><a href={`${root}reservas/`}>Reservar una mesa <span aria-hidden="true">↗</span></a><a href={`${root}carta/`}>Ver el menú <span aria-hidden="true">↗</span></a><a href={`${root}preguntas/`}>Preguntas frecuentes <span aria-hidden="true">↗</span></a><a href={`${root}visita/`}>Ubicación y horarios <span aria-hidden="true">↗</span></a></nav></div><div class="social-panel"><p class="eyebrow">Redes</p><div class="social-links">{c.contact.social_accounts.map(a=><div class="social-placeholder" data-social-placeholder><span>{a.label}</span><span class="social-state">De muestra</span></div>)}</div><p class="editorial-disclosure" data-contact-disclosure>Redes de ejemplo · sin perfiles reales vinculados. No se envían consultas desde esta demostración.</p>{!home&&!noSupplemental&&<ContextualImage handle={lab.experience_media.handle} at={lab.experience_media.evaluated_at} {route} slot="art:1004255" creditMode="linked" creditsHref={`${root}creditos/`} cover/>}</div></section>}
