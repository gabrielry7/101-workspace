---
// Generic, non-operational intent primitive. This does not add a business
// capability to H2, call a service, collect identity or persist preferences B4.
interface Props{kind:'request'|'selection'}
const {kind}=Astro.props;
---
{kind==='request'?<section id="encuentro" class="preview-intent visit-plan" data-operation="DEMO_ONLY">
 <div class="plan-intro"><h2>Planea tu visita</h2><p>Tres pasos para preparar la mesa que imaginas.</p><p class="demo-label">Demostración: sin disponibilidad real</p><p>No se envía ninguna solicitud, no se reserva una mesa y no recogemos datos personales.</p><slot name="scene"/></div>
 <form class="request-panel plan-form" data-visit-form data-operation="DEMO_ONLY" novalidate>
  <fieldset class="plan-step"><legend><span aria-hidden="true">1</span> ¿Cuándo?</legend><label>Día<input type="date" name="fecha"/></label><label>Momento<select name="momento"><option>Almuerzo · 13:00</option><option>Cena · 19:30</option></select></label></fieldset>
  <fieldset class="plan-step"><legend><span aria-hidden="true">2</span> ¿Cuántos?</legend><label>Personas<select name="personas" data-party><option>2 personas</option><option>4 personas</option><option>6 personas</option><option>8 personas</option></select></label></fieldset>
  <fieldset class="plan-step"><legend><span aria-hidden="true">3</span> ¿Qué ocasión?</legend><label>Ocasión<select name="ocasion"><option>Una buena comida</option><option>Cumpleaños</option><option>Celebración especial</option></select></label></fieldset>
  <details class="table-preview"><summary>Imaginar la distribución de mesas <span aria-hidden="true">＋</span></summary><p>Plano y ocupación simulados. Elige una mesa sólo para explorar esta interfaz.</p><div class="table-map" role="group" aria-label="Mesas de ejemplo, sin disponibilidad real">{[1,2,3,4,5,6].map(n=><button type="button" aria-pressed="false" disabled={n===3||n===6} data-demo-table={n}>Mesa {n}<small>{n===3||n===6?'Ocupada · ficción':'Ejemplo'}</small></button>)}</div></details>
  <aside class="plan-summary" aria-label="Resumen de tu visita"><h3>Tu visita</h3><p data-visit-summary>Elige día, personas y ocasión.</p><button type="submit" class="button primary demo-request">Ver resumen de ejemplo</button><p class="intent-status" role="status" data-request-status>No hay reserva ni conexión operativa.</p></aside>
 </form></section>:<aside id="seleccion" class="selection-preview" data-operation="DEMO_ONLY"><div><p class="kicker">Tu selección · sólo en esta pantalla</p><h2>¿Lo compartimos?</h2><p>Explora los platos y reúne tus favoritos en una selección de ejemplo. No es un carrito de compra y no hay pedido, entrega ni cobro.</p></div><div><p class="selection-count" data-selection-count>0 platos elegidos</p><ul data-selection-list></ul><p role="status" data-selection-status>Una carta para imaginar.</p><button type="button" class="text-link" data-selection-clear hidden>Vaciar selección de ejemplo</button></div></aside>}
