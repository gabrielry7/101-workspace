---
import type { LocationDirectoryContent, DirectoryView } from '../../bones/location-directory.ts';
interface Props { content: LocationDirectoryContent; view: DirectoryView; instanceId: string; mode?: 'panel'|'cards'|'both';
  icons?: Record<string,string>; media?: Record<string,string> }
const { content, view, instanceId, mode = 'both', icons = {}, media = {} } = Astro.props;
const part = (name: string) => `${view.id}:${name}`;
const target = (id: string) => `#${encodeURIComponent(`${instanceId}-view-${id}`)}`;
const offsets = view.groups.map((_, g) => view.groups.slice(0, g).reduce((n, group) => n + group.items.length, 0));
---
{mode !== 'cards' && <aside class="ld-panel reference-panel" data-directory-part={part('panel')} aria-label={view.panelTitle}>
  <h2 class="ld-panel-heading reference-panel-heading" data-directory-part={part('panel-title')}>
    {icons.location ? <Fragment set:html={icons.location}/> : <svg class="ld-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" fill="none" stroke="currentColor"/></svg>}{view.panelTitle}
  </h2>
  {view.level === 'overview' ? <div class="ld-regions reference-regions">
    {view.groups.map((group, g) => <section class="ld-region-group reference-region-group" data-directory-part={part(`group-${g + 1}`)} aria-label={group.label}>
      <h3>{group.label}</h3><br/>
      {group.items.map((item, i) => <div class="ld-region-item reference-region-item"><a href={target(item.viewId)} data-directory-target={item.viewId} data-directory-part={part(`entry-${offsets[g] + i + 1}`)}><span>{item.label}</span>{' '}<span class="ld-count reference-count" data-directory-part={part(`count-${offsets[g] + i + 1}`)} data-count-state={item.count === null ? 'unknown' : 'known'}>{item.count === null ? '—' : item.count}</span></a></div>)}<br/>
    </section>)}
  </div> : <ul class="ld-cities reference-cities">
    {view.entries.map((item, i) => <li><a href={target(item.viewId)} data-directory-target={item.viewId} data-directory-part={part(`entry-${i + 1}`)} aria-current={item.viewId === view.id ? 'location' : undefined}><span>{item.label}</span>{' '}<span class="ld-count reference-count" data-directory-part={part(`count-${i + 1}`)} data-count-state={item.count === null ? 'unknown' : 'known'}>{item.count === null ? '—' : item.count}</span></a></li>)}
    {view.entries.length === 0 && <li data-directory-part={part('empty')}>Sin entradas vinculadas</li>}
  </ul>}
  {view.openings.length > 0 && <><div class="ld-panel-divider reference-panel-divider"></div><ul class="ld-future-scroll reference-future-scroll">
    {view.openings.map((state, i) => <><li><h2 class="ld-panel-heading reference-panel-heading" data-directory-part={part(`opening-${i + 1}`)}>
      {icons.opening ? <Fragment set:html={icons.opening}/> : <svg class="ld-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor"/></svg>}{state.label}</h2></li>{state.items.map(label => <li>{label}</li>)}</>)}
  </ul></>}
  {view.parentId && <div class="ld-back reference-back"><a href={target(view.parentId)} data-directory-target={view.parentId} data-directory-part={part('back')}>
    {icons.back && <Fragment set:html={icons.back}/>} {content.labels.back}
  </a></div>}
</aside>}
{mode !== 'panel' && view.cards.length > 0 && <section class:list={['ld-cards reference-cards', {'ld-new-stores reference-new-stores': view.level === 'overview'}]} data-directory-part={part('cards')} aria-label={view.cardsTitle}>
  <div class="ld-cards-inner reference-cards-inner">
    <h2 data-directory-part={part('cards-title')}>{icons.cards ? <Fragment set:html={icons.cards}/> : <svg class="ld-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" fill="none" stroke="currentColor"/></svg>}{view.cardsTitle}</h2>
    <div class="ld-card-track reference-card-track" tabindex="0" role="region" data-directory-part={part('card-track')} aria-label={view.cardsTitle}>
      {view.cards.map(card => <article class="ld-card reference-card">
        {card.action.state === 'available' ? <a class="ld-card-body" href={card.action.href} data-directory-part={part(`action-${card.id}`)}>
          <div class="ld-card-media" data-slot-kind="location-image" data-directory-part={part(`media-${card.id}`)}>{media[`${view.id}:${card.id}`] ? <Fragment set:html={media[`${view.id}:${card.id}`]}/> : <span>{card.imageLabel}</span>}</div>
          <h3 data-directory-part={part(`title-${card.id}`)}>{card.title}</h3>
        </a> : <div class="ld-card-body" data-action-state="unbound" data-directory-part={part(`action-${card.id}`)}>
          <div class="ld-card-media" data-slot-kind="location-image" data-directory-part={part(`media-${card.id}`)}>{media[`${view.id}:${card.id}`] ? <Fragment set:html={media[`${view.id}:${card.id}`]}/> : <span>{card.imageLabel}</span>}</div>
          <h3 data-directory-part={part(`title-${card.id}`)}>{card.title}</h3>
        </div>}
      </article>)}
    </div>
    <div class="ld-card-dots reference-card-dots" data-directory-part={part('card-pages')} aria-label={content.labels.cardPage}></div>
  </div>
</section>}
