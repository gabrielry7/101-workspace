---
import { displayLocation, locationVariant, locationSkin, mapSkins, locationBone } from '../../bones/location-map.ts';
import type { LocationBoneInput, LocationVariant, LocationSkin } from '../../bones/location-map.ts';
interface Props {
  id: string; input: LocationBoneInput; variant?: LocationVariant; skin?: LocationSkin;
  runtimeURL?: string | undefined; provider?: 'maplibre' | 'google_js';
  basemap?: Record<string, unknown> | undefined; google?: Record<string, unknown> | undefined;
  markerLabel?: boolean;
  mapColors?: Partial<Record<keyof typeof mapSkins.neutral, string>>;
}
const { id, input, variant: variantValue = 'direct', skin: skinValue = 'neutral', runtimeURL,
  provider = 'maplibre', basemap, google, markerLabel = true, mapColors } = Astro.props;
if (typeof markerLabel !== 'boolean') throw Error('BOOLEAN_MARKER_LABEL_REQUIRED');
if (!/^[a-zA-Z][a-zA-Z0-9_-]{0,79}$/.test(id)) throw Error('LOCATION_ID_REQUIRED');
const variant = locationVariant(variantValue), skin = locationSkin(skinValue);
for (const [key, value] of Object.entries(mapColors ?? {})) {
  if (!Object.hasOwn(mapSkins.neutral, key) || !/^#[a-f0-9]{6}$/i.test(value)) throw Error('MAP_COLOR_FORMAT');
}
if (runtimeURL && !/^\/(?!\/)[a-zA-Z0-9_./-]+\.js$/.test(runtimeURL)) throw Error('LOCAL_LOCATION_RUNTIME_REQUIRED');
const content = displayLocation.parse(input.location);
const addressParts = (content.address ?? 'Dirección pendiente de confirmar.').split(/(\s+)/);
for (const link of input.directions) {
  const url = new URL(link.url);
  if (url.protocol !== 'https:' || url.username || url.password) throw Error('UNSAFE_DIRECTIONS_LINK');
}
const navigationId = `${id}-directions`;
const config = { location: input.location, marker: input.marker, markerLabel, provider, basemap, google,
  workerURL: runtimeURL?.replace(/[^/]+$/, 'maplibre-gl-worker.mjs'),
  navigationId, presentation: { colors: { ...mapSkins[skin], ...mapColors }, zoom: 16, pois: { mode: 'none', ids: [], limit: 0 } } };
---
<section id={id} class:list={['location-bone', `location-bone--${variant}`]} data-skin={skin}
  data-bone={`${locationBone.id}@${locationBone.version}`} data-variant={variant} aria-labelledby={`${id}-title`}>
  <header class="location-bone__header">
    <h2 id={`${id}-title`} data-location-part="heading">
      <span data-location-part="business-name">{content.name}</span>
    </h2>
    {variant !== 'direct' && <div class="location-bone__information">
      <address data-location-part="address">{addressParts.map(part => /\S/.test(part) ? <span>{part}</span> : part)}</address>
      <nav id={navigationId} data-location-part="directions" aria-label={`Indicaciones para ${content.name}`}>
        {input.directions.map(link => <a data-map-app={link.provider} href={link.url} target="_blank" rel="noopener noreferrer">Abrir en {link.label}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a>)}
        {!input.directions.length && input.synthetic && ['Google Maps','Waze','Apple Maps'].map(name => <span class="location-bone__action-placeholder" aria-disabled="true">Abrir en {name}</span>)}
        {!input.directions.length && <p class="location-bone__unavailable">{input.synthetic ? 'Acciones de muestra · sin destinos reales.' : 'Indicaciones pendientes de datos utilizables.'}</p>}
      </nav>
    </div>}
  </header>
  <div class="location-bone__body">
    {variant === 'direct' && <div class="location-bone__information">
      <address data-location-part="address">{addressParts.map(part => /\S/.test(part) ? <span>{part}</span> : part)}</address>
      <nav id={navigationId} data-location-part="directions" aria-label={`Indicaciones para ${content.name}`}>
        {input.directions.map(link => <a data-map-app={link.provider} href={link.url} target="_blank" rel="noopener noreferrer">Abrir en {link.label}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a>)}
        {!input.directions.length && input.synthetic && ['Google Maps','Waze','Apple Maps'].map(name => <span class="location-bone__action-placeholder" aria-disabled="true">Abrir en {name}</span>)}
        {!input.directions.length && <p class="location-bone__unavailable">{input.synthetic ? 'Acciones de muestra · sin destinos reales.' : 'Indicaciones pendientes de datos utilizables.'}</p>}
      </nav>
    </div>}
    <div class="location-bone__map" data-location-part="map-viewport">
      <div data-location-bone-config={JSON.stringify(config)} data-map-state="unmounted" data-map-reason="RUNTIME_NOT_LOADED">
        <div class="location-bone__placeholder" aria-hidden="true"><span>Mapa de la sucursal</span><span>Logo o pin en la coordenada comprobada</span></div>
        <p class="location-bone__fallback" data-location-part="status-fallback">El mapa interactivo necesita JavaScript y un proveedor disponible. La dirección y las indicaciones utilizables permanecen arriba.</p>
      </div>
      {input.marker.credit && <p class="location-bone__credit">{input.marker.credit}</p>}
    </div>
  </div>
</section>
{runtimeURL && <script type="module" src={runtimeURL} is:inline></script>}

<style>
  .location-bone { --section-paper:#fff;--section-ink:#222;--section-line:#aaa;--section-accent:#333;--map-height:438px;color:var(--section-ink);background:var(--section-paper);font-family:inherit;min-width:0; }
  .location-bone[data-skin="paper"] { --section-paper:#f6f0e5;--section-ink:#302d25;--section-line:#b6a78e;--section-accent:#7b4233;font-family:Georgia,serif; }
  .location-bone[data-skin="ink"] { --section-paper:#202b2c;--section-ink:#faf5e9;--section-line:#9caaa7;--section-accent:#faf5e9;font-family:Georgia,serif; }
  .location-bone[data-skin="neutral"] { --section-paper:Canvas;--section-ink:CanvasText;--section-line:GrayText;--section-accent:CanvasText;font-family:inherit; }
  .location-bone * { box-sizing:border-box; }
  .location-bone h2 { font-size:clamp(2rem,4vw,4.5rem);line-height:1.08;font-weight:400;letter-spacing:-.025em;margin:0;text-wrap:balance;overflow-wrap:normal;word-break:normal; }
  .location-bone address { font:inherit;font-size:1.15rem;line-height:1.5;margin:0 0 1.5rem;max-width:34ch;text-wrap:pretty; }
  .location-bone address span { white-space:nowrap; }
  .location-bone[data-skin="neutral"] h2 { font:inherit;letter-spacing:normal;text-wrap:pretty; }
  .location-bone[data-skin="neutral"] address { font:inherit; }
  .location-bone nav { display:grid;gap:10px; }
  .location-bone nav a { display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:56px;border:1px solid var(--section-line);padding:12px 16px;color:inherit;font:inherit;text-decoration:none; }
  .location-bone__action-placeholder { display:flex;align-items:center;min-height:56px;padding:12px 16px;border:1px dashed var(--section-line);font-size:.95rem; }
  .location-bone nav .location-bone__unavailable { grid-column:1/-1; }
  .location-bone nav a:hover { text-decoration:underline;text-underline-offset:4px; }
  .location-bone nav a:focus-visible { outline:3px solid var(--section-accent);outline-offset:4px; }
  .location-bone nav svg { flex:none;width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6; }
  .location-bone__information,.location-bone__map { min-width:0; }
  .location-bone__unavailable,.location-bone__fallback,.location-bone__credit { font-size:.875rem;line-height:1.6;margin:0;max-width:65ch; }
  .location-bone__fallback,.location-bone__credit { padding:12px 0; }
  .location-bone__placeholder { min-height:var(--map-height);display:flex;flex-direction:column;gap:12px;align-items:center;justify-content:center;padding:24px;background:#eee;color:#444;border:1px solid #aaa;text-align:center; }
  .location-bone__placeholder span:last-child { font-size:.875rem; }
  .location-bone--direct { padding:40px; }
  .location-bone--direct .location-bone__header { margin-bottom:42px; }
  .location-bone--direct .location-bone__body { display:grid;grid-template-columns:minmax(0,.78fr) minmax(0,1.62fr);gap:clamp(28px,5vw,76px);align-items:start; }
  .location-bone--map-led .location-bone__header { padding:40px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.3fr);gap:clamp(28px,4vw,56px);align-items:end; }
  .location-bone--map-led { --map-height:clamp(400px,42vw,560px); }
  .location-bone--map-led nav { grid-template-columns:repeat(3,minmax(0,1fr)); }
  .location-bone--editorial .location-bone__header { padding:clamp(36px,4.3vw,64px);display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:clamp(40px,7vw,110px); }
  .location-bone--editorial { --map-height:430px; }
  .location-bone--editorial h2 { max-width:12ch; }
  @media(max-width:1200px) { .location-bone--map-led nav { grid-template-columns:1fr; } }
  @media(max-width:900px) { .location-bone--direct { padding:28px; }.location-bone--direct .location-bone__body { gap:28px; }.location-bone--editorial .location-bone__header { padding:36px;gap:32px; } }
  @media(max-width:720px) { .location-bone--map-led .location-bone__header { grid-template-columns:1fr;padding:25px 22px;gap:22px; }.location-bone--map-led { --map-height:340px; } }
  @media(max-width:680px) { .location-bone--editorial .location-bone__header { grid-template-columns:1fr;padding:27px 24px;gap:27px; }.location-bone--editorial { --map-height:340px; } }
  @media(max-width:620px) { .location-bone--direct { padding:24px;--map-height:380px; }.location-bone--direct .location-bone__header { margin-bottom:28px; }.location-bone--direct .location-bone__body { grid-template-columns:1fr;gap:30px; }.location-bone--direct .location-bone__map { margin-inline:-24px; } }
  @media(forced-colors:active) { .location-bone { --section-paper:Canvas;--section-ink:CanvasText;--section-line:CanvasText;--section-accent:Highlight; } }
</style>
<style is:global>
  .location-bone .location-map { color:var(--section-ink); }
  .location-bone .location-map__canvas { height:var(--map-height); }
  .location-bone .location-map:not([data-map-state="ready"]) .single-business-marker { visibility:hidden; }
  .location-bone .single-business-marker { display:block;width:64px;height:80px;padding:0;border:0;background:none;color:var(--map-pin,#333);cursor:inherit; }
  .single-business-marker__visual { display:block;position:absolute;bottom:0;left:0;width:64px;height:80px; }
  .single-business-marker__frame { display:block;width:64px;height:80px; }
  .single-business-marker__logo { position:absolute;left:10px;top:10px;width:44px;height:44px;object-fit:contain; }
  .location-bone .location-map__marker-label { width:max-content;max-width:min(240px,65vw);white-space:normal;text-wrap:balance;overflow:visible;text-overflow:clip;word-break:normal;font-family:inherit; }
  .location-bone[data-skin="neutral"] .location-map__marker-label { background:Canvas;color:CanvasText;border:1px solid GrayText;border-radius:0;box-shadow:none;font:inherit; }
  .location-bone .location-map__status { font:inherit;font-size:.875rem;line-height:1.5; }
  .location-bone .single-business-marker:focus-visible { outline:3px solid var(--map-ink,#333);outline-offset:5px; }
  @media(forced-colors:active) { .single-business-marker__logo { background:Canvas;border-color:CanvasText; }.single-business-marker { color:CanvasText; } }
</style>
