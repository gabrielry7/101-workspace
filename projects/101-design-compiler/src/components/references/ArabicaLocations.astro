---
import Directory from '../bones/LocationDirectory.astro';
import { bindArabicaDirectory } from '../../references/arabica-directory.ts';
import { validateReferenceCatalogue, referenceVersion } from '../../references/arabica-locations.js';
import '../../styles/arabica-reference.css';
const { catalogue: supplied, runtimeURL = '/arabica/arabica-client.js' } = Astro.props;
const catalogue = validateReferenceCatalogue(supplied);
const { content, images } = bindArabicaDirectory(catalogue);
const serialised = JSON.stringify(catalogue).replace(/</g, '\\u003c');
---
<div class="arabica-reference" data-reference-version={referenceVersion}>
  <a class="reference-skip" href="#reference-locations">Skip to locations</a>
  <header class="reference-header">
    <button class="reference-menu-button" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="reference-navigation"><span class="reference-icon" aria-hidden="true">&#xe910;</span></button>
    <a class="reference-logo" href="https://arabica.com/en/" aria-label="% Arabica home"><span class="reference-icon" aria-hidden="true">&#xe906;</span></a>
    <nav class="reference-navigation" id="reference-navigation" aria-label="Main navigation">
      <a href="https://arabica.com/en/philosophy/">Philosophy</a><a href="/arabica/" data-reference-view="world" aria-current="page">Locations</a>
      <a href="https://arabica.com/en/shop/">Shop</a><a href="https://arabica.com/en/films/">Films</a><a href="https://arabica.com/en/contact/">Contact</a>
    </nav>
    <div class="reference-header-right"><a href="https://arabica.com/en/location/arabica-shokudo/">% Shokudō</a><a href="https://www.instagram.com/arabica.coffee/" aria-label="Instagram"><span class="reference-icon" aria-hidden="true">&#xe903;</span></a></div>
  </header>
  <main id="reference-locations">
    <Directory id="arabica-directory" content={content} runtimeURL={null} autoMount={false} queryKey="view" headingLevel={1}>
      <fragment slot="map"><span aria-hidden="true"></span></fragment>
      <fragment slot="map-overlay"><div class="reference-map-gate" data-map-gate><button type="button" data-activate-map>Activar Google Maps</button><p data-map-status role="status">La lista de ubicaciones está disponible.</p></div></fragment>
      <fragment slot="icon">{(role: string) => role === 'back'
        ? <><span class="reference-icon" aria-hidden="true">&#xe900;</span><span class="reference-icon reference-world-icon" aria-hidden="true">&#xe905;</span></>
        : <span class="reference-icon" aria-hidden="true">{role === 'cards' ? '\ue906' : '\ue904'}</span>}</fragment>
      <fragment slot="card-media">{(slot: {viewId:string;cardId:string;label:string}) => <img src={images.get(`${slot.viewId}:${slot.cardId}`)!.url} alt={slot.label} loading="lazy" width="270" height="118"/>}</fragment>
    </Directory>
  </main>
</div>
<script type="application/json" id="arabica-reference-input" set:html={serialised}></script>
<script is:inline type="module" src={runtimeURL}></script>
<style is:global>
  .arabica-reference .location-directory { font: inherit; }
  .arabica-reference .ld-card-media { display: block; padding: 0; aspect-ratio: auto; }
</style>
