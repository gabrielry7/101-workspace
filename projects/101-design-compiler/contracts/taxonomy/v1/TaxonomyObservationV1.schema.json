{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "field": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "value": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "provider_category_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "normalized_category": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "hierarchy": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_record_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "source_uri": {
            "type": "string",
            "format": "uri"
          },
          "inventory_record_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "inventory_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "source_record_id",
          "source",
          "observed_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "source",
    "field",
    "value",
    "hierarchy",
    "evidence_ids",
    "provenance"
  ],
  "additionalProperties": false,
  "$id": "urn:unocerouno:contracts:TaxonomyObservationV1:1.0.0",
  "title": "TaxonomyObservationV1",
  "description": "H1 candidate protocol; semantic checks required. No upstream integration."
}
