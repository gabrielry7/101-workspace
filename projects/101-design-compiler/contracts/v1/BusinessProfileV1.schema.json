{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "business_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "classification": {
      "type": "string",
      "enum": [
        "RESOLVED",
        "UNRESOLVED",
        "NON_BUSINESS"
      ]
    },
    "scope_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "archetypes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "food_hospitality",
              "product_retail",
              "appointment_service",
              "membership_and_classes",
              "lodging",
              "field_service_and_quote",
              "vehicle_service",
              "professional_advisory",
              "education_programs",
              "events_and_entertainment",
              "industrial_b2b",
              "property_and_spaces",
              "transport_and_logistics",
              "regulated_services"
            ]
          },
          "relevance": {
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "modifier"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "category_observation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "offering_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "required": [
          "id",
          "relevance",
          "confidence",
          "category_observation_ids",
          "offering_ids",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "offering_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "candidate_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "identity",
          "about",
          "locations",
          "opening_hours",
          "contact_channels",
          "social_profiles",
          "reputation",
          "gallery",
          "service_catalog",
          "product_catalog",
          "menu",
          "product_variants",
          "price_list",
          "packages",
          "rooms",
          "programs",
          "professional_profiles",
          "trainer_profiles",
          "portfolio",
          "case_studies",
          "reservation",
          "appointment",
          "quote_request",
          "contact_request",
          "purchase",
          "order",
          "delivery",
          "pickup",
          "membership",
          "membership_signup",
          "class_enrollment",
          "ticketing",
          "room_booking",
          "visit_booking",
          "service_request",
          "class_schedule",
          "events",
          "availability_display",
          "service_area",
          "delivery_policy",
          "visit_policy",
          "payment_methods",
          "amenities",
          "accessibility_info",
          "branches",
          "faqs",
          "documents"
        ]
      }
    },
    "missing_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "need": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "scope_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "requested_from": {
            "type": "string",
            "const": "upstream"
          }
        },
        "required": [
          "need",
          "scope_id",
          "reason",
          "requested_from"
        ],
        "additionalProperties": false
      }
    },
    "restrictions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "required": [
    "schema_version",
    "business_id",
    "snapshot_id",
    "id",
    "classification",
    "scope_ids",
    "archetypes",
    "offering_ids",
    "candidate_capabilities",
    "missing_inputs",
    "restrictions"
  ],
  "additionalProperties": false,
  "$id": "urn:unocerouno:contracts:BusinessProfileV1:1.0.0",
  "title": "BusinessProfileV1",
  "description": "H0 candidate contract; semantic validation is required in addition to JSON Schema."
}
