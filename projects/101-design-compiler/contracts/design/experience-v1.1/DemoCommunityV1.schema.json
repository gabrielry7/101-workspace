{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "kind": {
      "type": "string",
      "const": "FICTIONAL_EDITORIAL_COMMUNITY"
    },
    "data_mode": {
      "type": "string",
      "const": "SYNTHETIC_FIXTURE"
    },
    "disclosure": {
      "type": "string",
      "const": "Opiniones y publicaciones de muestra: textos ficticios, sin clientes ni cuentas reales."
    },
    "contact": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "const": "hola@lamesa.example"
        },
        "phone": {
          "type": "null"
        },
        "social_accounts": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "const": "Instagram"
                },
                "url": {
                  "type": "null"
                }
              },
              "required": [
                "label",
                "url"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "const": "Facebook"
                },
                "url": {
                  "type": "null"
                }
              },
              "required": [
                "label",
                "url"
              ],
              "additionalProperties": false
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "email",
        "phone",
        "social_accounts"
      ],
      "additionalProperties": false
    },
    "reviews": {
      "minItems": 3,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "const": "Opinión ficticia"
          },
          "author": {
            "type": "string",
            "pattern": "^Personaje de muestra [1-3]$"
          },
          "quote": {
            "type": "string",
            "minLength": 20
          },
          "verified_customer": {
            "type": "boolean",
            "const": false
          },
          "rating": {
            "type": "null"
          }
        },
        "required": [
          "id",
          "label",
          "author",
          "quote",
          "verified_customer",
          "rating"
        ],
        "additionalProperties": false
      }
    },
    "posts": {
      "minItems": 4,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slot": {
            "type": "string",
            "enum": [
              "pizza",
              "pasta",
              "salad",
              "dessert"
            ]
          },
          "title": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "const": "LOCAL_FICTIONAL_EDITORIAL_NOT_INSTAGRAM"
          },
          "social_metrics": {
            "type": "null"
          }
        },
        "required": [
          "id",
          "slot",
          "title",
          "caption",
          "source",
          "social_metrics"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "data_mode",
    "disclosure",
    "contact",
    "reviews",
    "posts"
  ],
  "additionalProperties": false,
  "$id": "urn:unocerouno:contracts:DemoCommunityV1:1.0.0",
  "title": "DemoCommunityV1",
  "description": "Associated B3 human feedback and fictional editorial scope; not final approval or a live social/review integration."
}
