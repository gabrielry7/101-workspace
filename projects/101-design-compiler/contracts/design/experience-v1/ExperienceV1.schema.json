{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "kind": {
      "type": "string",
      "const": "B3_MULTIPAGE_EXPERIENCE"
    },
    "source_context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "media_review_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "research_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "feedback_status": {
      "type": "string",
      "const": "HUMAN_REQUESTED_ITERATION_NO_SCORE"
    },
    "human_approval": {
      "type": "string",
      "const": "NOT_COLLECTED"
    },
    "profiles": {
      "minItems": 4,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^candidate-0[1-4]$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "root": {
            "type": "string",
            "pattern": "^\\/b3\\/candidate-0[1-4]\\/$"
          },
          "hero": {
            "type": "string",
            "enum": [
              "Immersive",
              "Masthead",
              "Cinema",
              "EditorialFilm"
            ]
          },
          "palette": {
            "type": "string",
            "enum": [
              "WhiteInk",
              "Vermilion",
              "Nocturne",
              "PureWhite"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "Classic",
              "Condensed",
              "Italic",
              "Modern"
            ]
          },
          "collection": {
            "type": "string",
            "enum": [
              "Spread",
              "Rows",
              "Exhibit",
              "Index"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 40
          },
          "references": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^reference-\\d{2}$"
            }
          }
        },
        "required": [
          "id",
          "label",
          "root",
          "hero",
          "palette",
          "type",
          "collection",
          "rationale",
          "references"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "source_context_sha256",
    "content_sha256",
    "plan_sha256",
    "media_review_sha256",
    "research_sha256",
    "feedback_status",
    "human_approval",
    "profiles"
  ],
  "additionalProperties": false,
  "$id": "urn:unocerouno:contracts:ExperienceV1:1.0.0",
  "title": "ExperienceV1",
  "description": "B3 associated multipage/background/credits revision; no operational backend or human aesthetic approval. Current byte and rights gates required."
}
