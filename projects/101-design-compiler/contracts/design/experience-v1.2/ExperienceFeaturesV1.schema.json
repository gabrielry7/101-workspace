{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "kind": {
      "type": "string",
      "const": "B3_FICTIONAL_FEATURE_PRESENTATION"
    },
    "data_mode": {
      "type": "string",
      "const": "SYNTHETIC_FIXTURE"
    },
    "house": {
      "type": "object",
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "copy": {
          "type": "string"
        }
      },
      "required": [
        "eyebrow",
        "title",
        "copy"
      ],
      "additionalProperties": false
    },
    "directory": {
      "minItems": 4,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page_kind": {
            "type": "string",
            "enum": [
              "collection",
              "story",
              "visit",
              "request",
              "selection",
              "faq"
            ]
          },
          "title": {
            "type": "string"
          },
          "copy": {
            "type": "string"
          }
        },
        "required": [
          "page_kind",
          "title",
          "copy"
        ],
        "additionalProperties": false
      }
    },
    "reads": {
      "minItems": 4,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "post_id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "body": {
            "minItems": 2,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 40
            }
          },
          "label": {
            "type": "string",
            "const": "Relato ficticio de muestra"
          }
        },
        "required": [
          "post_id",
          "category",
          "body",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "visit_prompt": {
      "type": "string"
    },
    "events_prompt": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "data_mode",
    "house",
    "directory",
    "reads",
    "visit_prompt",
    "events_prompt"
  ],
  "additionalProperties": false,
  "$id": "urn:unocerouno:contracts:ExperienceFeaturesV1:1.0.0",
  "title": "ExperienceFeaturesV1",
  "description": "Associated B3 iteration after human rejection; reference observations, fictional presentation and evidence bindings. No aesthetic approval, rights grant, backend or training."
}
