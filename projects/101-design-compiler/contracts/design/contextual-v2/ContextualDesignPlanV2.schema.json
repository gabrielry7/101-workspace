{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "art_direction_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "registry_version": {
      "type": "string",
      "const": "shared-contextual-2.0.0"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "media_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "route": {
      "type": "string",
      "pattern": "^\\/b3\\/[a-z0-9-]+\\/$"
    },
    "module_refs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recipe": {
      "type": "object",
      "properties": {
        "navigation": {
          "type": "string",
          "enum": [
            "Top",
            "Rail",
            "Index"
          ]
        },
        "hero": {
          "type": "string",
          "enum": [
            "Split",
            "Monument",
            "Diptych",
            "Stage"
          ]
        },
        "collection": {
          "type": "string",
          "enum": [
            "Grid",
            "Rows",
            "Mosaic"
          ]
        },
        "mobile_collection": {
          "type": "string",
          "enum": [
            "Stack",
            "Compact",
            "Sequence"
          ]
        },
        "narrative": {
          "type": "string",
          "enum": [
            "BeforeCollection",
            "AfterCollection"
          ]
        },
        "visit": {
          "type": "string",
          "enum": [
            "Columns",
            "Band"
          ]
        },
        "proportion": {
          "type": "string",
          "enum": [
            "balanced",
            "image-led",
            "type-led"
          ]
        },
        "measure": {
          "type": "string",
          "enum": [
            "wide",
            "contained"
          ]
        }
      },
      "required": [
        "navigation",
        "hero",
        "collection",
        "mobile_collection",
        "narrative",
        "visit",
        "proportion",
        "measure"
      ],
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "properties": {
        "palette": {
          "type": "string",
          "enum": [
            "paper",
            "tomato",
            "night",
            "olive"
          ]
        },
        "voice": {
          "type": "string",
          "enum": [
            "editorial",
            "humanist",
            "grotesk"
          ]
        },
        "scale": {
          "type": "string",
          "enum": [
            "monument",
            "display",
            "compact"
          ]
        },
        "rhythm": {
          "type": "string",
          "enum": [
            "airy",
            "measured",
            "tight"
          ]
        },
        "corners": {
          "type": "string",
          "enum": [
            "square",
            "soft"
          ]
        },
        "motion": {
          "type": "string",
          "const": "quiet"
        }
      },
      "required": [
        "palette",
        "voice",
        "scale",
        "rhythm",
        "corners",
        "motion"
      ],
      "additionalProperties": false
    },
    "sections": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "narrative": {
          "type": "string",
          "minLength": 1
        },
        "collection": {
          "type": "string",
          "minLength": 1
        },
        "information": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preview_intents": {
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "request",
              "selection"
            ]
          }
        }
      },
      "required": [
        "identity",
        "narrative",
        "collection",
        "information",
        "preview_intents"
      ],
      "additionalProperties": false
    },
    "operational_state": {
      "type": "string",
      "const": "SYNTHETIC_PREVIEW_NO_BACKEND"
    },
    "human_approval": {
      "type": "string",
      "const": "NOT_COLLECTED"
    }
  },
  "required": [
    "schema_version",
    "id",
    "art_direction_id",
    "registry_version",
    "context_sha256",
    "plan_sha256",
    "content_sha256",
    "media_sha256",
    "route",
    "module_refs",
    "recipe",
    "tokens",
    "sections",
    "operational_state",
    "human_approval"
  ],
  "additionalProperties": false,
  "$id": "urn:unocerouno:contracts:ContextualDesignPlanV2:2.0.0",
  "title": "ContextualDesignPlanV2",
  "description": "B3 associated contextual local-lab grammar/review; semantic, byte and current-use gates required. No human approval or commercial integration."
}
