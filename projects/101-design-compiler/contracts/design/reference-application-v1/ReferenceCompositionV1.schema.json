{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "kind": {
      "type": "string",
      "const": "ASSISTANT_REFERENCE_APPLICATION"
    },
    "source_context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "research_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "media_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authority": {
      "type": "string",
      "const": "ASSISTANT_OBSERVATIONS_NOT_NEW_USER_VOTES"
    },
    "human_approval": {
      "type": "string",
      "const": "NOT_COLLECTED"
    },
    "variants": {
      "minItems": 4,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "art_direction_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "relationship": {
            "type": "string",
            "enum": [
              "EditorialCard",
              "OffsetPair",
              "TypeGallery",
              "FramedCover"
            ]
          },
          "chapters": {
            "type": "string",
            "enum": [
              "Editorial",
              "Direct",
              "Exhibit",
              "Notebook"
            ]
          },
          "mobile": {
            "type": "string",
            "enum": [
              "ReadingFirst",
              "CompactIndex",
              "ImageSequence",
              "CoverFirst"
            ]
          },
          "palette": {
            "type": "string",
            "enum": [
              "paper",
              "tomato",
              "night",
              "olive"
            ]
          },
          "voice": {
            "type": "string",
            "enum": [
              "editorial",
              "humanist",
              "grotesk"
            ]
          },
          "references": {
            "minItems": 1,
            "maxItems": 21,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^reference-\\d{2}$"
            }
          },
          "decision": {
            "type": "string",
            "minLength": 30
          },
          "media_policy": {
            "type": "string",
            "const": "NATURAL_RATIO_NO_CROP_STATIC_HERO_REQUEST_VIDEO_640"
          }
        },
        "required": [
          "id",
          "art_direction_id",
          "relationship",
          "chapters",
          "mobile",
          "palette",
          "voice",
          "references",
          "decision",
          "media_policy"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "source_context_sha256",
    "research_sha256",
    "content_sha256",
    "media_sha256",
    "authority",
    "human_approval",
    "variants"
  ],
  "additionalProperties": false,
  "$id": "urn:unocerouno:contracts:ReferenceCompositionV1:1.0.0",
  "title": "ReferenceCompositionV1"
}
