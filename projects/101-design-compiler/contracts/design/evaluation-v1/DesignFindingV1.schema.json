{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "BLOCKING",
        "WARNING",
        "NOTE"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "MEASURED",
        "HEURISTIC",
        "AESTHETIC"
      ]
    },
    "route": {
      "type": "string",
      "format": "starts_with",
      "pattern": "^\\/.*"
    },
    "viewport": {
      "type": "string",
      "minLength": 1
    },
    "selector": {
      "type": "string"
    },
    "evidence": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommendation": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "receipt_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "tool",
          "version",
          "receipt_sha256"
        ],
        "additionalProperties": false
      }
    },
    "repair": {
      "type": "string",
      "enum": [
        "NONE",
        "READING_MEASURE",
        "TOUCH_TARGETS",
        "TYPE_RHYTHM",
        "TRACKING",
        "LABEL_PLACEMENT"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "rule",
    "severity",
    "kind",
    "route",
    "viewport",
    "selector",
    "evidence",
    "recommendation",
    "confidence",
    "sources",
    "repair"
  ],
  "additionalProperties": false,
  "$id": "urn:unocerouno:contracts:DesignFindingV1:1.0.0",
  "title": "DesignFindingV1"
}
