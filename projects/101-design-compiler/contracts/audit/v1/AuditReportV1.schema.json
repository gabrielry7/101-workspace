{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "semantic_page": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "type": "string",
      "minLength": 1
    },
    "viewport": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "LAB_TECHNICAL_PASS_NEEDS_HUMAN_REVIEW",
        "FAIL"
      ]
    },
    "production_ready": {
      "type": "boolean",
      "const": false
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "family": {
            "type": "string",
            "enum": [
              "input",
              "capabilities",
              "semantic",
              "rights",
              "geometry",
              "accessibility",
              "performance",
              "visual",
              "diversity"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "LAB_EXCEPTION",
              "NOT_MEASURED",
              "NOT_APPLICABLE"
            ]
          },
          "evidence_ref": {
            "type": "string"
          }
        },
        "required": [
          "family",
          "status",
          "evidence_ref"
        ],
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "enum": [
              "input",
              "capabilities",
              "semantic",
              "rights",
              "geometry",
              "accessibility",
              "performance",
              "visual",
              "diversity"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "BLOCKING",
              "OBSERVATION"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": "string",
            "minLength": 1
          },
          "viewport": {
            "type": "object",
            "properties": {
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "selector": {
            "type": "string"
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "repair": {
            "type": "string",
            "enum": [
              "FLUID_MEASURE",
              "NONE"
            ]
          }
        },
        "required": [
          "id",
          "family",
          "severity",
          "code",
          "route",
          "viewport",
          "selector",
          "evidence_ref",
          "observation",
          "repair"
        ],
        "additionalProperties": false
      }
    },
    "raster_status": {
      "type": "string",
      "enum": [
        "MEASURED_AUXILIARY",
        "NOT_MEASURED"
      ]
    },
    "human_preference": {
      "type": "string",
      "const": "NOT_COLLECTED"
    },
    "measurements": {
      "type": "object",
      "properties": {
        "page_body_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requests_including_document": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "byte_status": {
          "type": "string",
          "const": "MEASURED_LOCAL_UNCOMPRESSED"
        },
        "client_js_status": {
          "type": "string",
          "enum": [
            "ZERO_SCRIPTS_OBSERVED",
            "SCRIPT_PRESENT_BYTES_NOT_MEASURED"
          ]
        },
        "lcp": {
          "type": "string",
          "const": "NOT_MEASURED"
        },
        "inp": {
          "type": "string",
          "const": "NOT_MEASURED"
        },
        "cls": {
          "type": "string",
          "const": "NOT_MEASURED"
        },
        "field_p75": {
          "type": "string",
          "const": "NOT_MEASURED"
        },
        "video": {
          "type": "string",
          "const": "NOT_APPLICABLE"
        }
      },
      "required": [
        "page_body_bytes",
        "requests_including_document",
        "byte_status",
        "client_js_status",
        "lcp",
        "inp",
        "cls",
        "field_p75",
        "video"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "candidate_sha256",
    "policy_sha256",
    "semantic_page",
    "route",
    "viewport",
    "status",
    "production_ready",
    "families",
    "issues",
    "raster_status",
    "human_preference",
    "measurements"
  ],
  "additionalProperties": false,
  "$id": "urn:unocerouno:contracts:AuditReportV1:1.0.0",
  "title": "AuditReportV1",
  "description": "H6 laboratory audit/mutation/preference contract; hard gates and evidence required. No production approval or manufactured human votes."
}
