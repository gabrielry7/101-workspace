          "visit_policy",
          "payment_methods",
          "amenities",
          "accessibility_info",
          "branches",
          "faqs",
          "documents"
        ]
      }
    }
  },
  "required": [
    "id",
    "version",
    "semantic_module",
    "semantic_status",
    "selector",
    "offering_kinds",
    "offering_fact_requirements",
    "fact_kinds",
    "candidate_archetypes",
    "route",
