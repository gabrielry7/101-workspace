{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "enum": [
        "identity",
        "about",
        "locations",
        "opening_hours",
        "contact_channels",
        "social_profiles",
        "reputation",
        "gallery",
        "service_catalog",
        "product_catalog",
