{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "business_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "business_profile_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "capability_profile_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "registry_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "business_input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "taxonomy_registry_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "classification_context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "capability_id": {
            "type": "string",
            "enum": [
              "identity",
              "about",
              "locations",
              "opening_hours",
              "contact_channels",
              "social_profiles",
              "reputation",
              "gallery",
              "service_catalog",
              "product_catalog",
              "menu",
              "product_variants",
              "price_list",
              "packages",
              "rooms",
              "programs",
              "professional_profiles",
              "trainer_profiles",
              "portfolio",
              "case_studies",
              "reservation",
              "appointment",
              "quote_request",
              "contact_request",
              "purchase",
              "order",
              "delivery",
              "pickup",
              "membership",
              "membership_signup",
              "class_enrollment",
              "ticketing",
              "room_booking",
              "visit_booking",
              "service_request",
              "class_schedule",
              "events",
              "availability_display",
              "service_area",
              "delivery_policy",
              "visit_policy",
              "payment_methods",
              "amenities",
              "accessibility_info",
              "branches",
              "faqs",
              "documents"
            ]
          },
          "scope_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "type": "string",
            "enum": [
              "UPSTREAM",
              "CANDIDATE_ONLY",
              "ESSENTIAL_UNDECLARED"
            ]
          },
          "evidence_status": {
            "type": "string",
            "enum": [
              "CONFIRMED_PRESENT",
              "CONFIRMED_ABSENT",
              "UNKNOWN",
              "CONFLICTED",
              "WITHHELD"
            ]
          },
          "semantic_module": {
            "type": "string",
            "enum": [
              "identity",
              "offering_collection",
              "schedule",
              "fact_collection",
              "location_information",
              "external_action",
              "deferred_media"
            ]
          },
          "policy": {
            "type": "string",
            "enum": [
              "REQUIRED_IF_PRESENT",
              "CONDITIONAL",
              "OPTIONAL"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "disposition": {
            "type": "string",
            "enum": [
              "INCLUDED",
              "BLOCKED",
              "OMITTED"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "blocks_site": {
            "type": "boolean"
          },
          "route": {
            "type": "string",
            "pattern": "^\\/(?:[a-z0-9]+(?:-[a-z0-9]+)*\\/)*[a-z0-9-]*$"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "missing_inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "offering_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "action_destination_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "capability_id",
          "scope_id",
          "source",
          "evidence_status",
          "semantic_module",
          "policy",
          "priority",
          "disposition",
          "required",
          "blocks_site",
          "route",
          "depends_on",
          "missing_inputs",
          "fact_ids",
          "offering_ids"
        ],
        "additionalProperties": false
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "scope_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "capability_id": {
            "type": "string",
            "enum": [
              "identity",
              "about",
              "locations",
              "opening_hours",
              "contact_channels",
              "social_profiles",
              "reputation",
              "gallery",
              "service_catalog",
              "product_catalog",
              "menu",
              "product_variants",
              "price_list",
              "packages",
              "rooms",
              "programs",
              "professional_profiles",
              "trainer_profiles",
              "portfolio",
              "case_studies",
              "reservation",
              "appointment",
              "quote_request",
              "contact_request",
              "purchase",
              "order",
              "delivery",
              "pickup",
              "membership",
              "membership_signup",
              "class_enrollment",
              "ticketing",
              "room_booking",
              "visit_booking",
              "service_request",
              "class_schedule",
              "events",
              "availability_display",
              "service_area",
              "delivery_policy",
              "visit_policy",
              "payment_methods",
              "amenities",
              "accessibility_info",
              "branches",
              "faqs",
              "documents"
            ]
          },
          "fact_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "offering_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "requested_from": {
            "type": "string",
            "enum": [
              "upstream",
              "compiler"
            ]
          }
        },
        "required": [
          "code",
          "scope_id",
          "reason",
          "requested_from"
        ],
        "additionalProperties": false
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "scope_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "module_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "BOUND",
              "EVIDENCE_ONLY",
              "NOT_PUBLISHABLE",
              "UNBOUND"
            ]
          }
        },
        "required": [
          "fact_id",
          "scope_id",
          "module_ids",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "business_id",
    "snapshot_id",
    "business_profile_id",
    "capability_profile_id",
    "registry_sha256",
    "evaluated_at",
    "business_input_sha256",
    "taxonomy_registry_sha256",
    "classification_context_sha256",
    "requirements",
    "omissions",
    "bindings"
  ],
  "additionalProperties": false,
  "$id": "urn:unocerouno:contracts:SiteRequirementsV1:1.0.0",
  "title": "SiteRequirementsV1",
  "description": "H2 semantic contract; no visual representation or operational integration."
}
