    "label": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "group": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "registry_references": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "identity",
          "about",
          "locations",
          "opening_hours",
          "contact_channels",
          "social_profiles",
          "reputation",
          "gallery",
          "service_catalog",
          "product_catalog",
          "menu",
          "product_variants",
          "price_list",
          "packages",
          "rooms",
          "programs",
          "professional_profiles",
          "trainer_profiles",
          "portfolio",
          "case_studies",
          "reservation",
          "appointment",
          "quote_request",
          "contact_request",
          "purchase",
          "order",
          "delivery",
          "pickup",
          "membership",
          "membership_signup",
          "class_enrollment",
          "ticketing",
          "room_booking",
          "visit_booking",
          "service_request",
          "class_schedule",
          "events",
          "availability_display",
          "service_area",
          "delivery_policy",
          "visit_policy",
          "payment_methods",
          "amenities",
          "accessibility_info",
          "branches",
          "faqs",
          "documents"
        ]
      }
    },
    "registry_relation": {
      "type": "string",
      "enum": [
        "PARTIAL_V1_REFERENCE",
        "EXTENSION_REQUIRED"
      ]
    },
    "business_data": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "owner": {
            "type": "string",
            "enum": [
              "BUSINESS",
              "PROJECT",
              "PLATFORM",
              "RIGHTS_HOLDER"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "BUSINESS",
              "EXACT_BRANCH",
              "EXACT_OFFERING",
              "EXACT_PERSON",
              "EXACT_REVIEW",
              "EXACT_REVIEW_SUBJECT",
              "EXACT_RESOURCE",
              "EXACT_MEDIA_USAGE",
              "PROJECT"
            ]
          },
          "evidence_needed": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "validation_hint": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "label",
          "owner",
          "scope",
          "evidence_needed",
          "validation_hint"
        ],
        "additionalProperties": false
      }
    },
    "future_visitor_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "frontend_expectation": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "operation_dependencies": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "acceptance_checks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "expected_states": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "risks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "frontend_status": {
      "type": "string",
      "const": "NOT_BUILT"
    },
    "operation_status": {
      "type": "string",
      "const": "NOT_CONNECTED"
    },
    "data_status": {
      "type": "string",
      "const": "NOT_EVALUATED"
    }
  },
  "required": [
    "id",
    "label",
    "purpose",
    "group",
    "registry_references",
    "registry_relation",
    "business_data",
    "future_visitor_inputs",
    "frontend_expectation",
    "operation_dependencies",
    "depends_on",
    "acceptance_checks",
    "expected_states",
    "risks",
    "frontend_status",
    "operation_status",
    "data_status"
  ],
  "additionalProperties": false,
  "$id": "urn:unocerouno:contracts:ReviewFeatureV1:1.0.0",
  "title": "ReviewFeatureV1",
  "description": "B1 proposed human review supplement; partial V1 references, no business evaluation, commercial frontend or operational support. Semantic validation required."
}
