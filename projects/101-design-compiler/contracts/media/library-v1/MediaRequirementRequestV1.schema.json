            },
            "requirement_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "module_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "page": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "scope_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "purpose": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "role": {
              "type": "string",
              "enum": [
                "DOCUMENTARY",
                "ILLUSTRATIVE",
                "ATMOSPHERIC"
              ]
            },
            "subject_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "kinds": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "image",
                  "video",
                  "audio"
                ]
              }
            },
            "required": {
              "type": "boolean"
            },
            "count": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "min_width": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "min_height": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "requirement_id",
            "module_id",
            "page",
            "scope_id",
            "purpose",
            "role",
            "subject_ids",
            "kinds",
            "required",
            "count",
            "min_width",
            "min_height"
