        "SUBJECT_PENDING"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "DOCUMENTARY",
        "ILLUSTRATIVE",
        "ATMOSPHERIC"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "enum": [
