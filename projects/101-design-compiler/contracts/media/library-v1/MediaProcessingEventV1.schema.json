{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "SINGLE_SELECTED_TRANSFER",
        "TECHNICAL_DERIVATION",
        "LOCAL_VISUAL_INSPECTION"
      ]
    },
    "asset_ids": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parent_asset_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "count": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "receipt_path": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "kind",
    "asset_ids",
    "parent_asset_id",
    "count",
    "receipt_path"
  ],
  "additionalProperties": false,
  "$id": "urn:unocerouno:contracts:MediaProcessingEventV1:1.0.0",
  "title": "MediaProcessingEventV1",
  "description": "B2 associated byte-pinned media library and reference corpus; semantic, source, scope and current-use verification required. No rights conferred by fixture flags or reference URLs."
}
