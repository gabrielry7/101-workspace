  "components": [
    {
      "name": "Mercado primary action",
      "kind": "button",
      "refersTo": "market-button-primary",
      "description": "Home carta action; preview uses the source palette and shared action geometry.",
      "html": "<a class=\"ds-market-action\" href=\"#carta\">Ver la carta</a>",
      "css": ".ds-market-action{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 1.5rem;font:700 1rem \"DM Sans\",system-ui,sans-serif;color:#f6f7f1;background:#1e4d3a;border:2px solid #1e4d3a;text-decoration:none}.ds-market-action:hover{text-decoration:underline;text-underline-offset:.25em}.ds-market-action:focus-visible{outline:3px solid #1e4d3a;outline-offset:4px}@media(prefers-reduced-motion:no-preference){.ds-market-action{transition:background-color .2s ease-out,color .2s ease-out}}"
    },
    {
