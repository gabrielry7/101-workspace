    },
    {
      "name": "Mercado catalogue search",
      "kind": "input",
      "description": "Enhanced search field; visual snippet only, no search runtime.",
      "html": "<label class=\"ds-search\">Buscar en la carta<input type=\"search\" placeholder=\"¿Qué te apetece?\"></label>",
      "css": ".ds-search{display:grid;gap:.25rem;font:700 .875rem \"DM Sans\",system-ui,sans-serif;color:#17211c}.ds-search input{min-height:44px;padding:0 .75rem;font:400 1rem \"DM Sans\",system-ui,sans-serif;color:#17211c;background:#e9eee3;border:1px solid #6b7a70;border-radius:0}.ds-search input:focus-visible{outline:3px solid #1e4d3a;outline-offset:3px}"
    },
    {
      "name": "Mercado category chip",
      "kind": "chip",
      "description": "Real category link with pill silhouette.",
      "html": "<a class=\"ds-chip\" href=\"#categoria\">Entradas</a>",
      "css": ".ds-chip{display:inline-flex;align-items:center;min-height:44px;padding:0 1rem;font:600 1rem \"DM Sans\",system-ui,sans-serif;color:#1e4d3a;background:#f6f7f1;border:2px solid #1e4d3a;border-radius:999px;text-decoration:none}.ds-chip:hover{color:#17211c;background:#e8a317;border-color:#e8a317}.ds-chip:focus-visible{outline:3px solid #1e4d3a;outline-offset:4px}"
    },
    {
      "name": "Mercado native category navigation",
      "kind": "nav",
      "description": "Native disclosure remains usable without JavaScript; representative index, not the full viewport overlay.",
      "html": "<details class=\"ds-index\"><summary>Ir a una categoría</summary><nav aria-label=\"Categorías\"><a href=\"#categoria\">Entradas</a></nav></details>",
      "css": ".ds-index{font:1rem \"DM Sans\",system-ui,sans-serif;color:#17211c;border-top:1px solid #17211c;border-bottom:1px solid #d3d8cc}.ds-index summary{display:flex;align-items:center;min-height:44px;font-weight:700;cursor:pointer}.ds-index a{display:flex;align-items:center;min-height:44px;color:#1e4d3a;font-weight:600;text-underline-offset:.3em;text-decoration-color:#e8a317;text-decoration-thickness:2px}.ds-index a:hover{text-decoration:underline}.ds-index :is(summary,a):focus-visible{outline:3px solid #1e4d3a;outline-offset:3px}"
    },
    {
      "name": "Mercado selection container",
      "kind": "card",
      "description": "Native closed selection container; static zero-state visual excerpt only.",
      "html": "<details class=\"ds-selection\"><summary>Tu selección de ejemplo - 0 platos elegidos</summary><div class=\"ds-selection-panel\"><h2>Tu selección</h2><p>Ning?n plato elegido.</p></div></details>",
      "css": ".ds-selection{font:1rem \"DM Sans\",system-ui,sans-serif;color:#17211c}.ds-selection summary{display:flex;align-items:center;min-height:44px;padding:.25rem 1rem;font-weight:700;background:#e9eee3;border:1px solid #d3d8cc;cursor:pointer}.ds-selection summary:focus-visible{outline:3px solid #1e4d3a;outline-offset:3px}.ds-selection-panel{padding:2rem;background:#e9eee3;border-top:4px solid #e8a317}.ds-selection-panel h2{font:700 2rem/1.1 \"DM Sans\",system-ui,sans-serif;letter-spacing:-.025em}.ds-selection-panel p{font-size:.95rem}"
    },
    {
      "name": "Mercado ordinary menu row",
      "kind": "custom",
      "description": "One representative row of the forty-row catalogue; example text is not a new business fact.",
      "html": "<article class=\"ds-row\"><div class=\"ds-row-head\"><a href=\"#plato\">Plato de ejemplo</a><span>24.000 COP</span></div><p>Descripción ficticia de muestra.</p><a class=\"ds-row-open\" href=\"#plato\">Ver plato</a></article>",
      "css": ".ds-row{padding:.75rem .25rem .5rem;font:1rem/1.5 \"DM Sans\",system-ui,sans-serif;color:#17211c;border-bottom:1px solid #d3d8cc}.ds-row-head{display:flex;align-items:baseline;justify-content:space-between;gap:.5rem}.ds-row-head a{display:inline-flex;align-items:center;min-height:44px;font-size:1.1875rem;line-height:1.2;font-weight:700;color:inherit;text-decoration:none}.ds-row-head span{flex:none;font-size:1.0625rem;font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap}.ds-row p{margin:0;max-width:46ch;color:#4a5750}.ds-row-open{display:inline-flex;align-items:center;min-height:44px;color:#1e4d3a;font-weight:600;text-decoration-color:#e8a317;text-decoration-thickness:2px;text-underline-offset:.3em}.ds-row a:hover{text-decoration:underline}.ds-row a:focus-visible{outline:3px solid #1e4d3a;outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "One menu, four additional entry compositions",
    "overview": "Local source record of four proposed operators in an eight-option restaurant laboratory; not a globally approved product system. Original 01-04 remain PRELIMINARY_ACCEPTED and read-only. Mercado/Marea are general; Riso/Índice artistic. New 05-08 remain AWAITING_HUMAN_REVIEW. Independent SHIP means ready for preliminary user review only.\n\nCounter, arch, poster and index compositions present the same fictional restaurant and forty-dish journey through the existing shared Astro renderer. The descriptive north star records no new user vote or creative approval.",
    "keyCharacteristics": [
      "Four distinct entry compositions over shared semantic modules.",
      "Ordinary text menu, complete dish facts and local demonstration selection.",
      "Licensed atmosphere separated from dish evidence; missing media stays missing."
    ],
    "rules": [
      {
        "name": "The Scoped Palette Rule",
        "body": "An operator changes presentation; it does not rewrite facts or grant media rights.",
        "section": "colors"
      },
      {
        "name": "The Container Reading Rule",
        "body": "Size the wide Syne face from its actual column: section headings use clamp(1.375rem,9cqi,4.5rem), selection clamp(1rem,6cqi,2rem), and dish names clamp(1.25rem,7cqi,3.25rem). Preserve whole words with normal word-break and no hyphenation.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep each operator palette and display role scoped to its own routes.",
      "Do preserve whole-word reading, visible keyboard focus, native details and the forty-dish journey.",
      "Do preserve fictional labels, linked credits and media permission checks.",
      "Do use the existing shared renderer and semantic business modules."
    ],
    "donts": [
      "Don't treat this local record or reviewer SHIP as human approval or a production Design Lock.",
      "Don't copy atmosphere imagery into dish records or assign the original four dish assets to the new thirty-six.",
      "Don't turn inherited eyebrows, kickers or shared module ordinals into rules for future surfaces.",
      "Don't open a ninth operator before the roadmap's consolidation and authorized-data work."
    ]
  }
}
