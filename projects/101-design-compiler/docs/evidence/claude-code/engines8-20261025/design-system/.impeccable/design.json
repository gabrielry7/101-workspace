      "css": ".ds-marea-action{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 1.5rem;font:700 1rem \"DM Sans\",system-ui,sans-serif;color:#eef5f3;background:#0b2b3a;border:2px solid #0b2b3a;text-decoration:none}.ds-marea-action:hover{text-decoration:underline;text-underline-offset:.25em}.ds-marea-action:focus-visible{outline:3px solid #0e5f66;outline-offset:4px}@media(prefers-reduced-motion:no-preference){.ds-marea-action{transition:background-color .2s ease-out,color .2s ease-out}}"
    },
    {
