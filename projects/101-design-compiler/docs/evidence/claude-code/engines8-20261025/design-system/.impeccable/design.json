      "css": ".ds-riso-action{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 1.5rem;font:700 1rem \"DM Sans\",system-ui,sans-serif;color:#fff;background:#1d3fbb;border:2px solid #1d3fbb;text-decoration:none}.ds-riso-action:hover{text-decoration:underline;text-underline-offset:.25em}.ds-riso-action:focus-visible{outline:3px solid #1d3fbb;outline-offset:4px}@media(prefers-reduced-motion:no-preference){.ds-riso-action{transition:background-color .2s ease-out,color .2s ease-out}}"
