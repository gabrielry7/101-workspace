+.depth-experience label{font-weight:600}
+.depth-navigation>summary{border:1px solid currentColor;padding:0 1rem}
+.depth-navigation .navigation-heading em{color:var(--accent-text)}
+.navigation-groups a:hover{background:var(--surface)}
+.navigation-groups a[aria-current]{color:var(--accent-text)}
+.quick-nav a[href$="reservas/"]{background:var(--action);color:var(--on-action);padding:0 1.1rem}
