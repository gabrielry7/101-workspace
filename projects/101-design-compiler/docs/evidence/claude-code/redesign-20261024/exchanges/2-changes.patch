+
+/* ==== Palette directions (one per semantic tone; no customer or path selectors) ====
+   Tokens: --paper canvas · --ink text · --muted secondary text · --accent/--accent-text/--mark brand colour
+   (text-safe and decorative) · --line hairlines · --control form borders · --action/--on-action primary
+   button · --surface secondary plane · --focus ring · --footer-* closing band. */
+.depth-experience{--accent:var(--ink);--accent-text:var(--ink);--mark:var(--ink);--action:var(--ink);--on-action:var(--paper);--surface:#f3f3f0;--control:#767676;--focus:currentColor;--footer-bg:var(--ink);--footer-ink:var(--paper);--footer-muted:var(--paper)}
+/* WhiteInk · pan y brasa: bone paper, warm black ink, terracotta. Immersive entry stays dark and photographic. */
+.depth-experience.tone-WhiteInk{--paper:#fbf8f2;--ink:#1d1a16;--muted:#5b554b;--line:#ddd5c6;--control:#8b8272;--accent:#a5461c;--accent-text:#a5461c;--mark:#c4572a;--action:#1d1a16;--on-action:#fbf8f2;--surface:#f1ebdf;--focus:#a5461c;--footer-bg:#1d1a16;--footer-ink:#f4efe6;--footer-muted:#d2cab9}
+/* Vermilion · rojo de portada: warm white, brown-black text, vermilion for masthead, headings and actions. */
+.depth-experience.tone-Vermilion{--paper:#fffbf7;--ink:#2a1511;--muted:#6a4640;--line:#ecd3cb;--control:#a7746a;--accent:#b8231a;--accent-text:#b8231a;--mark:#d62b1d;--action:#b8231a;--on-action:#fff;--surface:#fbece6;--focus:#8f1d16;--head:#b8231a;--footer-bg:#b8231a;--footer-ink:#fff;--footer-muted:#ffe7e1}
+/* Graphite · verde tinta de noche: the whole route is a dark green-ink room with white type and celadon. */
+.depth-experience.tone-Graphite{--paper:#0f1612;--ink:#f2f1e9;--muted:#c1cabf;--line:#33433a;--control:#6f8577;--accent:#9fd3ac;--accent-text:#9fd3ac;--mark:#9fd3ac;--action:#bfe3c6;--on-action:#0f1612;--surface:#17211b;--surface-2:#1e2c24;--focus:#c9f0d0;--footer-bg:#080d0a;--footer-ink:#f2f1e9;--footer-muted:#b4bfb4;color-scheme:dark}
+/* NeutralAccent · índice lima: white grid, graphite ink, lime used as highlight plane, olive for text accents. */
+.depth-experience.tone-NeutralAccent{--paper:#fff;--ink:#131614;--muted:#4a514c;--line:#d5d9d4;--control:#7c847e;--accent:#d8f067;--accent-text:#3b5a0e;--mark:#bcdc3a;--action:#131614;--on-action:#d8f067;--surface:#f0f2ee;--focus:#131614;--footer-bg:#131614;--footer-ink:#f4f6f1;--footer-muted:#c0c7c0}
+.depth-experience.tone-Vermilion :is(h1,h2,.exp-brand){color:var(--head)}
+.experience-Immersive .experience-hero,.experience-GalleryStage .experience-hero,.experience-Immersive.page-home .depth-header,.experience-GalleryStage.page-home .depth-header{--focus:#fff}
+.experience-Immersive.page-home .depth-navigation nav{--focus:#a5461c}
+
+/* ==== Shared chrome ==== */
+.depth-experience :focus-visible{outline:3px solid var(--focus);outline-offset:4px}
+.depth-experience .eyebrow,.depth-experience .kicker{color:var(--accent-text);font-weight:600}
+.depth-experience .experience-hero .eyebrow{color:inherit}
+.experience-Immersive .experience-hero .eyebrow,.experience-GalleryStage .experience-hero .eyebrow{color:#fff}
+.depth-experience .primary,.depth-experience .demo-add,.depth-experience .visit-preparation .text-link,.depth-experience .community-contact-link{background:var(--action);color:var(--on-action);border:1px solid var(--action);text-decoration:none}
+.depth-experience .text-link:hover,.depth-experience .demo-add:hover{text-decoration:none}
+.depth-experience .text-link{border-bottom-width:2px;border-bottom-color:var(--mark)}
