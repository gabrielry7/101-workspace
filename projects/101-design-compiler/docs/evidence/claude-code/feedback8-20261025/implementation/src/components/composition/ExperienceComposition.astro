---
import Foundation from '../../layouts/Foundation.astro';
import ContextualImage from './ContextualImage.astro';
import CommunitySections from './CommunitySections.astro';
import ExperienceNavigation from './ExperienceNavigation.astro';
import HomeQuickLinks from './HomeQuickLinks.astro';
import InteriorPages from './InteriorPages.astro';
import CreditsList from './CreditsList.astro';
import SiteFooter from './SiteFooter.astro';
import DishDetail from './DishDetail.astro';
import ArtisticPages from './ArtisticPages.astro';
import StyleEngineSite from './StyleEngineSite.astro';
import {loadFeedbackMedia,feedbackDishVideo,evaluateFeedbackUsage} from '../../media/feedback-media.ts';
import {richExperiencePages as experiencePages} from '../../design/rich-experience-contracts.ts';
import {experienceRoute} from '../../design/experience-contracts.ts';
import {dishRoute} from '../../design/dish-routes.ts';
import {artisticDirectionFor} from '../../design/artistic-direction.ts';
import {engineForProfile} from '../../design/style-engines.ts';
import {pageHeads} from '../../design/nav-labels.ts';
import styles from '../../design/experience.css?raw';
import richStyles from '../../design/rich-experience.css?raw';
import depthStyles from '../../design/depth-experience.css?raw';
import refinementStyles from '../../design/experience-refinement.css?raw';
import emberStyles from '../../design/artistic-ember.css?raw';
import plateStyles from '../../design/artistic-plate.css?raw';
import dishStyles from '../../design/dish-detail.css?raw';
import catalogueStyles from '../../design/catalogue.css?raw';
import interiorStyles from '../../design/interior-kinds.css?raw';
import catalogueClient from '../../design/catalogue-client.js?url';
import feedbackClient from '../../design/b3-feedback-client.js?url';
import type {RestaurantCatalogue} from '../../design/restaurant-catalogue.ts';
import type {DepthExperience as Experience} from '../../design/depth-experience-contracts.ts';
import type {EngineProfile} from '../../design/style-engines.ts';
interface Props{lab:any&{catalogue?:RestaurantCatalogue};profile:Experience['profiles'][number]|EngineProfile;page:any;offering?:any}
const {lab,profile:p,page,offering}=Astro.props,engine=engineForProfile(p.id);
const s=lab.scenario,route=offering?dishRoute(p.root,offering.id):experienceRoute(p.root,page),pageKind=offering?'dish':page.kind,dishName=offering?.facts.find((f:any)=>f.kind==='offering_name')?.text;
const modules=s.content.pages.flatMap((q:any)=>q.modules),by=(c:string)=>modules.find((m:any)=>m.capability_id===c),identity=by('identity'),menu=lab.catalogue?.module??by('menu'),catalogue=lab.catalogue;
const name=identity.facts.find((f:any)=>f.kind==='business_name'),tagline=identity.facts.find((f:any)=>f.kind!=='business_name');
const link=(kind:string)=>experienceRoute(p.root,experiencePages.find(q=>q.kind===kind)! as any);
const creditHref=link('credits'),carta=link('collection');
const art=artisticDirectionFor(p.hero),variant=art==='EmberReel'?'ember':art==='PlateStudy'?'plate':p.hero==='Masthead'?'front-page':'ledger';
const skin=(art==='EmberReel'?'frames':art==='PlateStudy'?'plate':p.hero==='Masthead'?'front-page':'ledger') as 'ledger'|'front-page'|'frames'|'plate';
const fm=await loadFeedbackMedia();
const dishGroup=offering?catalogue?.groups.find((g:any)=>g.offering_ids.includes(offering.id)):undefined;
const catalogueFlow=!!catalogue&&page.kind==='collection';
let movie:any,poster:any,motion:any,posterUse:any;
if(fm&&page.kind==='home'&&!art){
 const uses=fm.review.usages.filter((u:any)=>u.page===route);
 if(uses.some((u:any)=>evaluateFeedbackUsage(fm.handle,u,fm.evaluated_at).status!=='ALLOWED'))throw Error('EXPERIENCE_RENDER_USE_BLOCKED');
 motion=uses.find((u:any)=>u.need_id==='b3-need:motion');movie=motion&&fm.review.assets.find((a:any)=>a.id===motion.asset_id);
 posterUse=uses.find((u:any)=>u.need_id==='b3-need:hero'&&fm.review.assets.find((a:any)=>a.id===u.asset_id)?.inspection.width===1280);poster=posterUse&&fm.review.assets.find((a:any)=>a.id===posterUse.asset_id);
}
const videoOverride=fm&&offering?await feedbackDishVideo(offering.id,route):undefined;
const css=(styles+'\n'+richStyles+'\n'+depthStyles+'\n'+refinementStyles+(art==='EmberReel'?'\n'+emberStyles:art==='PlateStudy'?'\n'+plateStyles:'')+(offering?'\n'+dishStyles:'')+(catalogue&&(offering||catalogueFlow)?'\n'+catalogueStyles:'')+'\n'+interiorStyles).replaceAll('\r\n','\n');
const cl=fm?{...lab,experience_media:fm}:lab;
const title=offering?`${dishName} · ${name.text}`:`${name.text} · ${pageKind==='home'?'Inicio':pageHeads[pageKind]?.h??page.label}`;
---
{engine?<StyleEngineSite {lab} profile={p} {page} {offering} {engine}/>:<Foundation title={`${title} · ${p.label}`}>
 <style is:inline set:html={css}/>
 <div class:list={art?['contextual-site','experience-site','rich-experience','depth-experience','artistic-site',`art-${art}`,`page-${pageKind}`]:['contextual-site','experience-site','rich-experience','depth-experience',`experience-${p.hero}`,`tone-${p.palette}`,`type-${p.type}`,`catalogue-${p.collection}`,`page-${pageKind}`]} data-experience-sha256={lab.site_sha256} data-editorial-sha256={lab.site.editorial_sha256} data-feedback-sha256={lab.site.feedback_sha256} data-revision-feedback-sha256={lab.site.revision_feedback_sha256} data-features-sha256={lab.site.features_sha256} data-depth-research-sha256={lab.site.depth_research_sha256} data-profile-id={p.id} data-page-kind={pageKind} data-content-sha256={s.content.content_sha256} data-plan-sha256={s.content.plan_sha256} data-media-sha256={fm!.review.review_sha256} data-catalogue-sha256={catalogue?.sha256}>
  <ExperienceNavigation root={p.root} name={name.text} kind={pageKind} parentKind={offering?'collection':undefined}/>
  {offering?<div class="experience-content dish-content" id="experience-main" tabindex="-1">
   <nav class="depth-breadcrumb" aria-label="Ruta de navegación"><a href={p.root}>Inicio</a><a href={carta}>Menú</a>{dishGroup&&<a href={`${carta}#cat-${dishGroup.id}`}>{dishGroup.label}</a>}<span aria-current="page">{dishName}</span></nav>
   <DishDetail {offering} menu={menu} {route} root={p.root} collectionHref={carta} selectionHref={link('selection')} reserveHref={link('request')} presentation={lab.presentation} {catalogue} mediaOverride={fm} {videoOverride} bindings={fm!.review.dish_bindings??{}}/>
  </div>:art&&page.kind!=='credits'?<ArtisticPages {art} {lab} fm={fm} profile={p} {page} {route} {creditHref}/>:page.kind==='home'?<>
   <section class="experience-hero" id="experience-main" tabindex="-1" data-module-id={identity.id} data-component={identity.component} data-scope-id={identity.scope_id} data-semantic-page={identity.page} data-required={String(identity.required)}>
    <div class="hero-title"><h1 data-fact-id={name.id} data-fact-scope={name.scope_id}>{name.text}</h1><p class="hero-tagline" data-fact-id={tagline.id} data-fact-scope={tagline.scope_id}>{tagline.text}</p></div>
    <div class="hero-film" data-feedback-background data-film-state="poster">
     <ContextualImage handle={fm!.handle} at={fm!.evaluated_at} {route} slot="hero" hero creditMode="linked" creditsHref={creditHref} cover/>
     <video muted loop playsinline preload="none" poster={poster!.uri} width="1280" height="720" data-src={movie!.uri} data-media-usage={motion!.id} data-poster-usage={posterUse!.id} aria-hidden="true" tabindex="-1"></video>
     <div class="film-shade" aria-hidden="true"></div>
    </div>
    <div class="hero-entry-links"><a href={carta}>Ver el menú <span aria-hidden="true">↗</span></a><a href={link('request')}>Reservar mesa <span aria-hidden="true">↗</span></a></div>
   </section>
   <CommunitySections lab={cl} root={p.root} {route} mode="home" only={['reviews']}/>
   <HomeQuickLinks root={p.root}/>
   <CommunitySections lab={cl} root={p.root} {route} mode="home" only={['journal']}/>
  </>:page.kind==='credits'?<CreditsList fm={fm} root={p.root} {s} {variant}/>:<InteriorPages {lab} fm={fm} root={p.root} kind={page.kind} {route} {variant} {skin}/>}
  <SiteFooter root={p.root} name={name.text}/>
 </div>
 {catalogueFlow&&<script is:inline type="module" src={catalogueClient}></script>}
 <script is:inline type="module" src={feedbackClient}></script>
</Foundation>}
<script>import '../../design/depth-experience-client.ts';import '../../design/experience-refinement-client.ts';</script>
