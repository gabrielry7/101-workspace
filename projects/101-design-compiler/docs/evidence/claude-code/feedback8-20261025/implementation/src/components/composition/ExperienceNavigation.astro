---
import {richExperiencePages} from '../../design/rich-experience-contracts.ts';
import {experienceRoute} from '../../design/experience-contracts.ts';
import {publicLabel,navKinds} from '../../design/nav-labels.ts';
interface Props{root:string;name:string;kind:string;parentKind?:string|undefined}
const {root,name,kind,parentKind}=Astro.props;
const groups=[{label:'La mesa',kinds:['collection','request']},{label:'El restaurante',kinds:['story','visit','faq']},{label:'Más',kinds:['journal','reviews','contact']}];
const href=(k:string)=>experienceRoute(root,richExperiencePages.find(p=>p.kind===k)! as any);
if(groups.flatMap(g=>g.kinds).join()!==navKinds.join())throw Error('NAV_KINDS_MISMATCH');
---
<header class="exp-header depth-header"><a class="exp-brand" href={root} aria-label={`${name}, inicio`}>{name}</a><div class="quick-nav"><a href={href('collection')} aria-current={kind==='collection'||parentKind==='collection'?'page':undefined}>Menú</a><a href={href('request')} aria-current={kind==='request'?'page':undefined}>Reservas</a></div><details class="depth-navigation" data-depth-nav><summary>Explorar <span aria-hidden="true">＋</span></summary><nav aria-label="Navegación principal"><div class="navigation-groups">{groups.map(g=><div><p class="eyebrow">{g.label}</p>{g.kinds.map(k=><a href={href(k)} aria-current={kind===k?'page':parentKind===k?'true':undefined}>{publicLabel(k)}<span aria-hidden="true">↗</span></a>)}</div>)}</div><div class="nav-utility"><button type="button" class="motion-toggle" data-motion-toggle aria-pressed="false" hidden>Pausar vídeo de fondo</button></div><p class="navigation-context">Restaurante ficticio · reservas de demostración.</p></nav></details></header>
