---
// Art image for the two artistic operators, served from the feedback media package (slot art:ID).
import {loadFeedbackMedia,evaluateFeedbackUsage} from '../../media/feedback-media.ts';
interface Props{id:number|string;route:string;creditsHref:string;class?:string;hero?:boolean;sizes?:string|undefined}
const {id,route,creditsHref,class:className,hero=false,sizes}=Astro.props;
const resolvedSizes=sizes??(hero?'100vw':'(min-width: 1000px) 640px, (min-width: 761px) 50vw, calc(100vw - 40px)');
const root=route.match(/^\/b3\/candidate-0[1-8]\//)?.[0];if(!root||creditsHref!==root+'creditos/')throw Error('ART_CREDIT_ROUTE_MISMATCH');
const fm=await loadFeedbackMedia(),{review}=fm;
const uses=review.usages.filter((u:any)=>u.page===route&&u.need_id===`b3-need:art:${id}`);
if(!uses.length||uses.some((u:any)=>evaluateFeedbackUsage(fm.handle,u,fm.evaluated_at).status!=='ALLOWED'))throw Error('ART_IMAGE_USE_BLOCKED');
const assets=uses.map((u:any)=>review.assets.find((x:any)=>x.id===u.asset_id)!),a=assets[0]!;if(assets.some((x:any)=>x.kind!=='image'))throw Error('ART_IMAGE_EXPECTED');
---
<figure class:list={['contextual-photo','media-cover','art-photo',className]} data-art-asset={id} data-art-review={review.review_sha256} data-art-usage={uses.map((u:any)=>u.id).join(' ')} data-credit-href={creditsHref}>
 <picture><source type="image/webp" srcset={assets.map((x:any)=>`${x.uri} ${x.inspection.width}w`).join(', ')} sizes={resolvedSizes}/><img src={a.uri} width={a.inspection.width!} height={a.inspection.height!} alt={`${a.inspection.subject}. Imagen ilustrativa de stock; no representa el negocio ni sus productos reales.`} loading={hero?'eager':'lazy'} fetchpriority={hero?'high':undefined} decoding="async"/></picture>
</figure>
