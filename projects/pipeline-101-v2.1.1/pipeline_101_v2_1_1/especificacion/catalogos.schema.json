              },
              "given": {
                "type": "string",
                "minLength": 1
              },
              "when": {
                "type": "string",
                "minLength": 1
              },
              "expected": {
                "type": "string",
                "minLength": 1
              },
              "evidence_required": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "implementation_ref": {
                "type": "null"
