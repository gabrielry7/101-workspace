{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unocerouno:pipeline:catalogs:2.1.1",
  "title": "Catálogos documentales y perfil propuesto — 2.1.1",
  "description": "Esquema de ESTA entrega: prohíbe inventar ejecuciones. Los reportes operativos se mantienen separados.",
  "$defs": {
    "GateCatalog": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.1.1"
        },
        "kind": {
          "const": "gate_catalog"
        },
        "status": {
          "const": "SPECIFICATION_NOT_IMPLEMENTATION"
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "gate_id": {
                "enum": [
                  "G00",
                  "G01",
                  "G02",
                  "G03",
                  "G04a",
                  "G04b",
                  "G05",
                  "G06",
                  "G07",
                  "G08",
                  "G09",
                  "G10",
                  "G11",
                  "G12",
                  "G13",
                  "G14",
                  "G15",
                  "G16"
                ]
              },
              "policy_version": {
                "const": "2.1.1"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "applicability": {
                "type": "object",
                "properties": {
                  "scope": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pilot_required": {
                    "type": "boolean"
                  },
                  "required_for_prepublication": {
                    "type": "boolean"
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  },
                  "contexts": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "prepublication",
                        "postdeployment",
                        "evaluation"
                      ]
                    },
                    "uniqueItems": true,
                    "minItems": 1
                  }
                },
                "required": [
                  "scope",
                  "pilot_required",
                  "required_for_prepublication",
                  "note",
                  "contexts"
                ],
                "additionalProperties": false
              },
              "acceptance_rule": {
                "type": "string",
                "minLength": 1
              },
              "default_severity": {
                "enum": [
                  "BLOCKER",
                  "MAJOR",
                  "MINOR"
                ]
              },
              "responsible_role": {
                "type": "string",
                "minLength": 1
              },
              "checker_status": {
                "const": "TO_INTEGRATE"
              },
              "checker_ref": {
                "type": "null"
              },
              "test_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^T[0-9]{2}$"
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "evidence_required": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "repair_action": {
                "type": "string",
                "minLength": 1
              },
              "invalidate_on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "empty_or_missing_evidence_result": {
                "const": "INCONCLUSIVE"
              },
              "review_policy_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "gate_id",
              "policy_version",
              "title",
              "stage",
              "applicability",
              "acceptance_rule",
              "default_severity",
              "responsible_role",
              "checker_status",
              "checker_ref",
              "test_ids",
              "evidence_required",
              "repair_action",
              "invalidate_on",
              "empty_or_missing_evidence_result"
