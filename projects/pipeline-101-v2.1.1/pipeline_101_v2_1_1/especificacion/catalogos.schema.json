                      "enum": [
                        "public_info",
                        "menu_html",
                        "whatsapp_contact",
                        "whatsapp_request",
                        "reservation_request",
                        "reservation_confirmed",
                        "online_payment",
                        "delivery_dispatch",
                        "customer_accounts",
                        "loyalty"
