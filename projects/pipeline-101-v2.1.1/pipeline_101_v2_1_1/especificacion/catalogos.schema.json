                "additionalProperties": false
              },
              "gate_contexts": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "enum": [
                    "G00",
                    "G01",
                    "G02",
                    "G03",
                    "G04a",
                    "G04b",
                    "G05",
                    "G06",
                    "G07",
                    "G08",
                    "G09",
                    "G10",
                    "G11",
                    "G12",
                    "G13",
                    "G14",
                    "G15",
                    "G16"
