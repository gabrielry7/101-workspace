{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unocerouno:pipeline:contracts:2.1.1",
  "title": "Pipeline 101 v2.1.1: contratos de referencia",
  "description": "Valida estructura; no confirma hechos, derechos, identidad, pagos ni elegibilidad de producción.",
  "$defs": {
    "Money": {
      "type": "object",
      "properties": {
        "amount_minor": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "minor_unit_exponent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      },
      "required": [
        "amount_minor",
        "currency",
        "minor_unit_exponent"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "currency": {
                "const": "COP"
              }
            }
          },
          "then": {
            "properties": {
              "minor_unit_exponent": {
                "const": 2
              }
            }
          }
        }
      ]
    },
    "Fact": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "fact"
        },
        "schema_version": {
          "const": "2.1.1"
        },
        "fact_id": {
          "type": "string",
          "minLength": 1
        },
        "business_id": {
          "type": "string",
          "minLength": 1
        },
        "location_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "field_key": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "verified_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "verified_by": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_from": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "review_due_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "verification_status": {
          "enum": [
            "unverified",
            "verified",
            "disputed",
            "stale",
            "rejected"
          ]
        },
        "publication_class": {
          "enum": [
            "public_required",
            "public_optional",
            "internal"
          ]
        },
        "usage_state": {
          "enum": [
            "cleared",
            "pending",
            "denied",
            "expired",
            "revoked"
          ]
        },
        "conflict_open": {
          "type": "boolean"
        },
        "approval_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "schema_version",
        "fact_id",
        "business_id",
        "location_id",
        "field_key",
        "value",
        "source_refs",
        "observed_at",
        "verified_at",
        "verified_by",
        "valid_from",
        "valid_until",
        "review_due_at",
        "verification_status",
        "publication_class",
        "usage_state",
        "conflict_open",
        "approval_ref"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_status": {
                "const": "verified"
              }
            }
          },
          "then": {
            "properties": {
              "verified_at": {
                "type": "string",
                "format": "date-time"
              },
              "verified_by": {
                "type": "string",
                "minLength": 1
              },
              "review_due_at": {
                "type": "string",
                "format": "date-time"
              },
              "approval_ref": {
                "type": "string",
                "minLength": 1
              },
              "conflict_open": {
                "const": false
              },
              "value": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field_key": {
                "pattern": "(^|\\.)price$"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Money"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "AssetRights": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "asset_rights"
        },
        "schema_version": {
          "const": "2.1.1"
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "source_uri": {
          "type": "string",
          "minLength": 1
        },
        "rights_basis": {
          "enum": [
            "owned",
            "licensed",
            "permission",
            "provider_terms",
            "unresolved"
          ]
        },
        "status": {
          "enum": [
            "cleared",
            "pending",
            "denied",
            "expired",
            "revoked"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowed_surfaces": {
          "type": "array",
          "items": {
            "enum": [
              "private_review",
              "public_web",
              "public_metadata",
              "public_derivatives"
            ]
          },
          "uniqueItems": true
        },
        "attribution_required": {
          "type": "boolean"
        },
        "attribution_text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "restrictions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reviewed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewed_by": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "schema_version",
        "asset_id",
        "source_uri",
        "rights_basis",
        "status",
        "evidence_refs",
        "allowed_surfaces",
        "attribution_required",
        "attribution_text",
        "restrictions",
        "reviewed_at",
        "reviewed_by",
        "expires_at"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "cleared"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "allowed_surfaces": {
                "minItems": 1
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              },
              "reviewed_by": {
                "type": "string",
                "minLength": 1
              },
              "rights_basis": {
                "not": {
                  "const": "unresolved"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "attribution_required": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "attribution_text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "Capability": {
      "type": "object",
      "properties": {
        "capability_id": {
          "enum": [
            "public_info",
            "menu_html",
            "whatsapp_contact",
            "whatsapp_request",
            "reservation_request",
            "reservation_confirmed",
            "online_payment",
            "delivery_dispatch",
            "customer_accounts",
            "loyalty"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "manual",
            "automated",
            "none"
          ]
        },
        "owner_role": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "enum": [
              "public_info",
              "menu_html",
              "whatsapp_contact",
              "whatsapp_request",
              "reservation_request",
              "reservation_confirmed",
              "online_payment",
              "delivery_dispatch",
              "customer_accounts",
              "loyalty"
            ]
          },
          "uniqueItems": true
        },
        "operations_policy_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "required_test_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^T[0-9]{2}$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "capability_id",
        "enabled",
        "mode",
        "owner_role",
        "dependencies",
        "operations_policy_ref",
        "required_test_ids"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "mode": {
                "enum": [
                  "manual",
                  "automated"
                ]
              },
              "owner_role": {
                "type": "string",
                "minLength": 1
              },
              "operations_policy_ref": {
                "type": "string",
                "minLength": 1
              },
              "required_test_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "CapabilityPlan": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "capability_plan"
        },
        "schema_version": {
          "const": "2.1.1"
        },
        "plan_id": {
          "type": "string",
          "minLength": 1
        },
        "business_id": {
          "type": "string",
          "minLength": 1
        },
        "location_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "mode": {
          "enum": [
            "prospect_private",
            "authorized_live"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "schema_version",
        "plan_id",
        "business_id",
        "location_ids",
        "mode",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "additionalProperties": false
    },
    "CandidateInputs": {
      "type": "object",
      "properties": {
        "business_id": {
          "type": "string",
          "minLength": 1
        },
        "location_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "mode": {
          "enum": [
            "prospect_private",
            "authorized_live"
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 1
        },
        "data_snapshot_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capability_plan_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "site_plan_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "design_spec_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "asset_manifest_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "operations_policy_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "toolchain_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "content_version": {
          "type": "string",
          "minLength": 1
        },
        "catalog_version": {
          "type": "string",
          "minLength": 1
        },
        "design_version": {
          "type": "string",
          "minLength": 1
        },
        "backend_contract_version": {
          "type": "string",
          "minLength": 1
        },
        "compiler_commit": {
          "type": "string",
          "minLength": 1
        },
        "pipeline_policy_version": {
          "const": "2.1.1"
        },
        "applicability_profile_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "business_id",
        "location_ids",
        "mode",
        "artifacts",
        "data_snapshot_hash",
        "capability_plan_hash",
        "site_plan_hash",
        "design_spec_hash",
        "asset_manifest_hash",
        "operations_policy_hash",
        "toolchain_hash",
        "content_version",
        "catalog_version",
        "design_version",
        "backend_contract_version",
        "compiler_commit",
        "pipeline_policy_version",
        "applicability_profile_hash"
      ],
      "additionalProperties": false
    },
    "ReleaseManifest": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "release_manifest"
        },
        "schema_version": {
          "const": "2.1.1"
        },
        "release_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_inputs": {
          "$ref": "#/$defs/CandidateInputs"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "kind",
        "schema_version",
        "release_id",
        "candidate_hash",
        "candidate_inputs",
        "created_at"
      ],
      "additionalProperties": false
    },
    "Approval": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "approval"
        },
        "schema_version": {
          "const": "2.1.1"
        },
        "approval_id": {
          "type": "string",
          "minLength": 1
        },
        "business_id": {
          "type": "string",
          "minLength": 1
        },
        "location_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "subject_type": {
          "enum": [
            "release_candidate",
            "data_snapshot",
            "design_spec"
          ]
        },
        "subject_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "actor_role": {
          "enum": [
            "business_admin",
            "authorized_staff",
            "design_reviewer",
            "release_operator"
          ]
        },
        "authority_ref": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "items": {
            "enum": [
              "facts",
              "design",
              "operations",
              "publication"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "decision": {
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "revoked_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "schema_version",
        "approval_id",
        "business_id",
        "location_ids",
        "subject_type",
        "subject_hash",
        "actor_id",
        "actor_role",
        "authority_ref",
        "scope",
        "decision",
        "decided_at",
        "expires_at",
        "revoked_at",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "CaseResult": {
      "type": "object",
      "properties": {
        "test_id": {
          "type": "string",
          "pattern": "^T[0-9]{2}$"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN",
            "INCONCLUSIVE",
            "NOT_APPLICABLE"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "not_applicable_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "test_id",
        "status",
        "evidence_refs",
        "not_applicable_reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_APPLICABLE"
              }
            }
          },
          "then": {
            "properties": {
              "not_applicable_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "Finding": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "BLOCKER",
            "MAJOR",
            "MINOR"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "owner_role": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "owner_role",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "GateResult": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "gate_result"
        },
        "schema_version": {
          "const": "2.1.1"
        },
        "gate_id": {
          "enum": [
            "G00",
            "G01",
            "G02",
            "G03",
            "G04a",
            "G04b",
            "G05",
            "G06",
            "G07",
            "G08",
            "G09",
            "G10",
            "G11",
            "G12",
            "G13",
            "G14",
            "G15",
            "G16"
          ]
        },
        "gate_policy_version": {
          "const": "2.1.1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_type": {
          "enum": [
            "repository",
            "data_bundle",
            "release_candidate",
            "deployment",
            "experiment"
          ]
        },
        "subject_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checker_version": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "enum": [
            "spec_example",
            "development",
            "staging",
            "production"
          ]
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "PASS",
