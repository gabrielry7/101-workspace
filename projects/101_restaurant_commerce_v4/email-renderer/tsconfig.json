{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src",
    "emails"
  ]
}
